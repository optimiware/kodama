# Kodema application image: one static kodema binary on a minimal Alpine base.
#
# Build from the repository root:
#   podman build -f deploy/images/kodema/Containerfile -t <registry>/kodema:<tag> .
# The runtime needs the git binary (Git service and hooks run it) and CA roots
# (OIDC discovery and KMS calls). It runs as the non-root UID the chart expects.

# Both bases are pinned by the digest of their multi-architecture index, not of
# one platform's image: the build stage then runs on the build machine's own
# architecture, and the runtime stage gets the git and shell of the target's.
FROM --platform=$BUILDPLATFORM docker.io/library/golang:1.27.3-alpine@sha256:fa3d596898d9f126af7c01d14ee7597bab3f39cccf392ef36b69fe77cd681f18 AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
# VERSION and REVISION are what `kodema version` prints. The build context has
# no .git directory, so the caller passes them (scripts/image does). TARGETOS
# and TARGETARCH cross-compile natively on BUILDPLATFORM without QEMU overhead.
ARG TARGETOS=linux
ARG TARGETARCH
ARG VERSION=dev
ARG REVISION=
RUN CGO_ENABLED=0 GOOS=${TARGETOS} GOARCH=${TARGETARCH} go build -trimpath -buildvcs=false \
      -ldflags="-s -w -X main.version=${VERSION} -X main.revision=${REVISION}" \
      -o /out/kodema ./cmd/kodema

FROM docker.io/library/alpine:3.24@sha256:f59abe656b692d901e184be3445e084786602108599d2a51d229c0f5a48c71bf
# git-daemon supplies git-http-backend, the CGI program `kodema git serve` runs
# for every smart-HTTP exchange; Alpine's `git` package does not ship it.
RUN apk add --no-cache ca-certificates git git-daemon \
 && addgroup -g 65532 kodema \
 && adduser -D -u 65532 -G kodema -h /var/lib/kodema kodema \
 && mkdir -p /var/lib/kodema && chown 65532:65532 /var/lib/kodema
COPY --from=build /out/kodema /usr/local/bin/kodema
LABEL org.opencontainers.image.title="kodema" \
      org.opencontainers.image.source="https://github.com/optimiware/kodema" \
      org.opencontainers.image.licenses="Apache-2.0"
USER 65532:65532
EXPOSE 8443
VOLUME ["/var/lib/kodema"]
ENTRYPOINT ["/usr/local/bin/kodema"]
