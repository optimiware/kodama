# Copy to <state dir>/clusters/<name>/scw.tfvars (default ~/kodama-stage/state) and edit; never next to the root.
project_id                = "11111111-1111-4111-8111-111111111111"
# installation_id is set by deploy.sh to kodama-<name> (--name); this value is overridden.
installation_id           = "kodama-stage-scw"
region                    = "fr-par"
environment_tier          = "staging"
kubernetes_version        = "1.37.1"
node_type                 = "DEV1-L"
node_count                = 4
node_min_count            = 4
node_max_count            = 8
db_node_type              = "DB-DEV-S"
db_engine_version         = "PostgreSQL-17"
db_backup_frequency_hours = 24
db_backup_retention_days  = 7
ingress_host              = "kodama.stage.scw.example.invalid"
operator_user_ids         = ["22222222-2222-4222-8222-222222222222"]
runtime_callback_cidrs    = ["172.16.40.0/22"]

tenants = [
  {
    namespace = "kodama-tenant-stage"
    tenant_id = "t_stage"
  }
]
