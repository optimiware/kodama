# Namespaces, trust material, credentials and the database roles of one installation.
# Everything here is generated by OpenTofu (state is the source of truth, kept outside the checkout), pushed
# into Kubernetes before any chart installs, and stable across applies: a value changes only when its
# resource is replaced (`tofu apply -replace=...`), never because a script ran again.

locals {
  installation = var.stage_contract.installation_id
  host         = var.stage_contract.network.ingress_host
  public_hosts = [
    local.host,
    "grafana.${local.host}",
    "auth.${local.host}",
    "git.${local.host}",
    "registry.${local.host}",
  ]
  pg                = var.stage_contract.postgres
  tenant_ids        = [for t in var.stage_contract.tenants : t.tenant_id]
  git_url_effective = coalesce(var.git_url, "https://git.${local.host}/optimi/kodama-source.git")
  git_origin        = "https://${split("/", trimprefix(local.git_url_effective, "https://"))[0]}/"
  personas          = ["admin", "analyst", "engineer", "reviewer", "viewer", "outsider", "foreign"]
  nats_dns = [
    "kodama-nats",
    "kodama-nats.${var.control_plane_namespace}",
    "kodama-nats.${var.control_plane_namespace}.svc",
    "kodama-nats.${var.control_plane_namespace}.svc.cluster.local",
  ]
}

# ---- namespaces ----

resource "kubernetes_namespace_v1" "control_plane" {
  metadata {
    name = var.control_plane_namespace
  }
}

resource "kubernetes_namespace_v1" "observability" {
  metadata {
    name = var.observability_namespace
  }
}

resource "kubernetes_namespace_v1" "deps" {
  metadata {
    name = var.deps_namespace
  }
}

# ---- installation CA and leaf certificates ----

resource "tls_private_key" "ca" {
  algorithm   = "ECDSA"
  ecdsa_curve = "P256"
}

resource "tls_self_signed_cert" "ca" {
  private_key_pem       = tls_private_key.ca.private_key_pem
  is_ca_certificate     = true
  validity_period_hours = 8760 * 3
  early_renewal_hours   = 24 * 60
  allowed_uses          = ["cert_signing", "crl_signing"]

  subject {
    common_name = "${local.installation}-ca"
  }
}

resource "tls_private_key" "nats" {
  algorithm   = "ECDSA"
  ecdsa_curve = "P256"
}

resource "tls_cert_request" "nats" {
  private_key_pem = tls_private_key.nats.private_key_pem
  dns_names       = local.nats_dns

  subject {
    common_name = local.nats_dns[3]
  }
}

resource "tls_locally_signed_cert" "nats" {
  cert_request_pem      = tls_cert_request.nats.cert_request_pem
  ca_private_key_pem    = tls_private_key.ca.private_key_pem
  ca_cert_pem           = tls_self_signed_cert.ca.cert_pem
  validity_period_hours = 8760
  early_renewal_hours   = 24 * 30
  allowed_uses          = ["digital_signature", "key_encipherment", "server_auth"]
}

resource "tls_private_key" "ingress" {
  algorithm   = "ECDSA"
  ecdsa_curve = "P256"
}

resource "tls_cert_request" "ingress" {
  private_key_pem = tls_private_key.ingress.private_key_pem
  dns_names       = local.public_hosts

  subject {
    common_name = local.host
  }
}

resource "tls_locally_signed_cert" "ingress" {
  cert_request_pem      = tls_cert_request.ingress.cert_request_pem
  ca_private_key_pem    = tls_private_key.ca.private_key_pem
  ca_cert_pem           = tls_self_signed_cert.ca.cert_pem
  validity_period_hours = 8760
  early_renewal_hours   = 24 * 30
  allowed_uses          = ["digital_signature", "key_encipherment", "server_auth"]
}

# Runtime P-256 signing key (PKCS#8 PEM), the key tokens of the workload runtime API are signed with.
resource "tls_private_key" "runtime_signing" {
  algorithm   = "ECDSA"
  ecdsa_curve = "P256"
}

# ---- generated credentials ----

locals {
  # A cloud root that provisions the database roles itself (Scaleway: the admin user cannot grant on the
  # platform-owned database) hands over their passwords; otherwise the roles are created below by SQL.
  external_roles     = lookup(var.bootstrap_secrets, "migration_password", "") != "" && lookup(var.bootstrap_secrets, "runtime_password", "") != ""
  migration_password = local.external_roles ? var.bootstrap_secrets["migration_password"] : random_password.migration.result
  runtime_password   = local.external_roles ? var.bootstrap_secrets["runtime_password"] : random_password.runtime.result
}

resource "random_password" "migration" {
  length  = 40
  special = false
}

resource "random_password" "runtime" {
  length  = 40
  special = false
}

resource "random_password" "nats_token" {
  length  = 48
  special = false
}

resource "random_bytes" "cursor_key" {
  length = 32
}

resource "random_bytes" "idempotency_hash_key" {
  length = 32
}

resource "random_password" "grafana_admin" {
  length  = 32
  special = false
}

resource "random_password" "gitea_admin" {
  length  = 40
  special = false
}

resource "random_password" "dex_api_client" {
  length  = 48
  special = false
}

resource "random_password" "dex_tests_client" {
  length  = 48
  special = false
}

resource "random_password" "persona" {
  for_each = toset(local.personas)
  length   = 32
  special  = false
}

resource "htpasswd_password" "persona" {
  for_each = toset(local.personas)
  password = random_password.persona[each.key].result
}

# ---- database roles (run from inside the cluster: managed PostgreSQL has no public endpoint) ----

locals {
  roles_sql = <<-SQL
    DO $$
    BEGIN
      IF NOT EXISTS (SELECT 1 FROM pg_roles WHERE rolname = '${local.pg.migration_role}') THEN
        CREATE ROLE ${local.pg.migration_role} LOGIN PASSWORD '${random_password.migration.result}' NOSUPERUSER NOCREATEDB NOCREATEROLE NOBYPASSRLS;
      ELSE
        ALTER ROLE ${local.pg.migration_role} WITH LOGIN PASSWORD '${random_password.migration.result}' NOSUPERUSER NOCREATEDB NOCREATEROLE NOBYPASSRLS;
      END IF;
      IF NOT EXISTS (SELECT 1 FROM pg_roles WHERE rolname = '${local.pg.runtime_role}') THEN
        CREATE ROLE ${local.pg.runtime_role} LOGIN PASSWORD '${random_password.runtime.result}' NOSUPERUSER NOCREATEDB NOCREATEROLE NOBYPASSRLS;
      ELSE
        ALTER ROLE ${local.pg.runtime_role} WITH LOGIN PASSWORD '${random_password.runtime.result}' NOSUPERUSER NOCREATEDB NOCREATEROLE NOBYPASSRLS;
      END IF;
    END
    $$;
    GRANT ALL PRIVILEGES ON DATABASE ${local.pg.database} TO ${local.pg.migration_role};
    GRANT ALL ON SCHEMA public TO ${local.pg.migration_role};
    GRANT CONNECT ON DATABASE ${local.pg.database} TO ${local.pg.runtime_role};
  SQL

  admin_dsn   = "postgres://${urlencode(var.bootstrap_secrets["postgres_admin_username"])}:${urlencode(var.bootstrap_secrets["postgres_admin_password"])}@${local.pg.host}:${local.pg.port}/${local.pg.database}?sslmode=${local.pg.ssl_mode}"
  roles_token = substr(sha256(local.roles_sql), 0, 10)
}

resource "kubernetes_secret_v1" "bootstrap_sql" {
  count = local.external_roles ? 0 : 1

  metadata {
    name      = "kodama-bootstrap-sql-${local.roles_token}"
    namespace = kubernetes_namespace_v1.control_plane.metadata[0].name
  }
  data = {
    "dsn"       = local.admin_dsn
    "roles.sql" = local.roles_sql
  }
}

resource "kubernetes_job_v1" "bootstrap_sql" {
  count = local.external_roles ? 0 : 1

  metadata {
    name      = "kodama-bootstrap-sql-${local.roles_token}"
    namespace = kubernetes_namespace_v1.control_plane.metadata[0].name
  }

  spec {
    backoff_limit              = 2
    ttl_seconds_after_finished = 600

    template {
      metadata {}
      spec {
        restart_policy = "Never"
        security_context {
          run_as_non_root = true
          run_as_user     = 70
          fs_group        = 70
          seccomp_profile {
            type = "RuntimeDefault"
          }
        }
        container {
          name    = "psql"
          image   = var.psql_image
          command = ["sh", "-c", "psql \"$(cat /sql/dsn)\" -v ON_ERROR_STOP=1 -f /sql/roles.sql"]
          security_context {
            allow_privilege_escalation = false
            capabilities {
              drop = ["ALL"]
            }
          }
          resources {
            limits = {
              memory = "128Mi"
            }
          }
          volume_mount {
            name       = "sql"
            mount_path = "/sql"
            read_only  = true
          }
        }
        volume {
          name = "sql"
          secret {
            secret_name  = kubernetes_secret_v1.bootstrap_sql[0].metadata[0].name
            default_mode = "0440"
          }
        }
      }
    }
  }

  wait_for_completion = true
  timeouts {
    create = "5m"
  }
}

# ---- Git tokens minted by deps-init.sh (read back so the runtime Secret is declarative) ----

data "kubernetes_secret_v1" "git_tokens" {
  metadata {
    name      = "kodama-git-tokens"
    namespace = var.deps_namespace
  }
  depends_on = [terraform_data.deps_init]
}

# ---- Secrets and ConfigMaps ----

resource "kubernetes_secret_v1" "runtime" {
  metadata {
    name      = "kodama-runtime"
    namespace = kubernetes_namespace_v1.control_plane.metadata[0].name
  }

  data = {
    "database-runtime-url" = "postgres://${local.pg.runtime_role}:${local.runtime_password}@${local.pg.host}:${local.pg.port}/${local.pg.database}?sslmode=${local.pg.ssl_mode}"
    "nats-token"           = random_password.nats_token.result
    "git-read-token"       = data.kubernetes_secret_v1.git_tokens.data["read"]
    "git-write-token"      = data.kubernetes_secret_v1.git_tokens.data["write"]
    "runtime-signing-key"  = tls_private_key.runtime_signing.private_key_pem_pkcs8
    "runtime-ca.crt"       = tls_self_signed_cert.ca.cert_pem
    "ca.crt"               = tls_self_signed_cert.ca.cert_pem
    "s3-access-key"        = var.bootstrap_secrets["artifacts_s3_access_key"]
    "s3-secret-key"        = var.bootstrap_secrets["artifacts_s3_secret_key"]
    "git-credentials.json" = jsonencode([
      {
        ref          = "secret://installation/checkout"
        username     = "git"
        passwordFile = "git-read-token"
        urlPrefix    = local.git_origin
        tenants      = local.tenant_ids
      },
      {
        ref          = "secret://installation/publisher"
        username     = "git"
        passwordFile = "git-write-token"
        urlPrefix    = local.git_origin
        tenants      = local.tenant_ids
      },
    ])
  }

  binary_data = {
    "cursor-key"           = random_bytes.cursor_key.base64
    "idempotency-hash-key" = random_bytes.idempotency_hash_key.base64
  }
}

resource "kubernetes_secret_v1" "migration" {
  metadata {
    name      = "kodama-migration"
    namespace = kubernetes_namespace_v1.control_plane.metadata[0].name
  }

  data = {
    "database-migration-url" = "postgres://${local.pg.migration_role}:${local.migration_password}@${local.pg.host}:${local.pg.port}/${local.pg.database}?sslmode=${local.pg.ssl_mode}"
    "ca.crt"                 = tls_self_signed_cert.ca.cert_pem
  }
}

resource "kubernetes_secret_v1" "nats_auth" {
  metadata {
    name      = "kodama-nats-auth"
    namespace = kubernetes_namespace_v1.control_plane.metadata[0].name
  }
  data = {
    "nats-token" = random_password.nats_token.result
  }
}

resource "kubernetes_secret_v1" "nats_tls" {
  metadata {
    name      = "kodama-nats-tls"
    namespace = kubernetes_namespace_v1.control_plane.metadata[0].name
  }
  data = {
    "ca.crt"  = tls_self_signed_cert.ca.cert_pem
    "tls.crt" = tls_locally_signed_cert.nats.cert_pem
    "tls.key" = tls_private_key.nats.private_key_pem_pkcs8
  }
}

resource "kubernetes_secret_v1" "ingress_tls" {
  for_each = {
    kodama-tls         = var.control_plane_namespace
    kodama-grafana-tls = var.observability_namespace
    kodama-deps-tls    = var.deps_namespace
  }

  metadata {
    name      = each.key
    namespace = each.value
  }
  type = "kubernetes.io/tls"
  data = {
    "tls.crt" = "${tls_locally_signed_cert.ingress.cert_pem}${tls_self_signed_cert.ca.cert_pem}"
    "tls.key" = tls_private_key.ingress.private_key_pem_pkcs8
  }

  depends_on = [kubernetes_namespace_v1.control_plane, kubernetes_namespace_v1.observability, kubernetes_namespace_v1.deps]
}

resource "kubernetes_secret_v1" "kms_scw" {
  count = var.stage_contract.kms.provider == "scw" ? 1 : 0

  metadata {
    name      = var.stage_contract.kms.scw_credentials_secret
    namespace = kubernetes_namespace_v1.control_plane.metadata[0].name
  }
  data = {
    "secret-key" = var.bootstrap_secrets["scw_kms_secret_key"]
  }
}

resource "kubernetes_secret_v1" "loki_s3" {
  metadata {
    name      = "kodama-loki-s3"
    namespace = kubernetes_namespace_v1.observability.metadata[0].name
  }
  data = {
    "AWS_ACCESS_KEY_ID"     = var.bootstrap_secrets["logs_s3_access_key"]
    "AWS_SECRET_ACCESS_KEY" = var.bootstrap_secrets["logs_s3_secret_key"]
  }
}

resource "kubernetes_secret_v1" "grafana_admin" {
  metadata {
    name      = "kodama-grafana-admin"
    namespace = kubernetes_namespace_v1.observability.metadata[0].name
  }
  data = {
    "admin-user"     = "operator"
    "admin-password" = random_password.grafana_admin.result
  }
}

resource "kubernetes_config_map_v1" "grafana_dashboards" {
  metadata {
    name      = "kodama-grafana-dashboards"
    namespace = kubernetes_namespace_v1.observability.metadata[0].name
  }
  data = {
    "kodama-pipeline-logs.json" = file("${path.module}/values/dashboards/kodama-pipeline-logs.json")
  }
}

resource "kubernetes_secret_v1" "gitea_admin" {
  metadata {
    name      = "kodama-gitea-admin"
    namespace = kubernetes_namespace_v1.deps.metadata[0].name
  }
  data = {
    "username" = "kodama-admin"
    "password" = random_password.gitea_admin.result
  }
}

resource "kubernetes_secret_v1" "deps_auth" {
  metadata {
    name      = "kodama-deps-auth"
    namespace = kubernetes_namespace_v1.deps.metadata[0].name
  }
  data = {
    "dex-api-client-secret"   = random_password.dex_api_client.result
    "dex-tests-client-secret" = random_password.dex_tests_client.result
    "personas.json"           = jsonencode({ for p in local.personas : p => { password = random_password.persona[p].result } })
  }
}
