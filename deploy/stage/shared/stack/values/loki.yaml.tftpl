# Loki SingleBinary shared Helm values for pipeline & control-plane log search.
# Isolated in logs_bucket (${object_storage.logs_bucket}); 30-day retention per O-11.
deploymentMode: SingleBinary

serviceAccount:
  create: true
  annotations:
%{ if length(sa_annotations) == 0 ~}
    {}
%{ else ~}
%{ for k, v in sa_annotations ~}
    ${jsonencode(k)}: ${jsonencode(v)}
%{ endfor ~}
%{ endif ~}

loki:
  auth_enabled: false
  commonConfig:
    replication_factor: 1
  limits_config:
    allow_structured_metadata: true
    retention_period: 720h
    reject_old_samples: true
    reject_old_samples_max_age: 168h
  compactor:
    retention_enabled: true
    delete_request_store: s3
  schemaConfig:
    configs:
      - from: "2026-01-01"
        store: tsdb
        object_store: s3
        schema: v13
        index:
          prefix: loki_index_
          period: 24h
  storage:
    type: s3
    bucketNames:
      chunks: ${jsonencode(object_storage.logs_bucket)}
      ruler: ${jsonencode(object_storage.logs_bucket)}
      admin: ${jsonencode(object_storage.logs_bucket)}
    s3:
      endpoint: ${jsonencode(object_storage.endpoint)}
      region: ${jsonencode(object_storage.region)}
      s3ForcePathStyle: ${object_storage.path_style}
      insecure: false

singleBinary:
  replicas: 1
  extraEnvFrom:
    - secretRef:
        name: kodama-loki-s3
  extraArgs:
    - -config.expand-env=true
  persistence:
    enabled: true
    size: 10Gi

gateway:
  enabled: false
chunksCache:
  enabled: false
resultsCache:
  enabled: false
read:
  replicas: 0
write:
  replicas: 0
backend:
  replicas: 0
test:
  enabled: false
lokiCanary:
  enabled: false
