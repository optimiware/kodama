# Grafana Alloy shared Helm values.
# Tails Pod logs over the Kubernetes API (loki.source.kubernetes) without hostPath or root.
# Restricts stream labels to low-cardinality keys and stores job_name/pod/attempt_id as Loki structured metadata.
controller:
  type: deployment
  replicas: 1
  volumes:
    extra:
      - name: tmp
        emptyDir: {}

alloy:
  securityContext:
    runAsNonRoot: true
    runAsUser: 65532
    runAsGroup: 65532
    allowPrivilegeEscalation: false
    readOnlyRootFilesystem: true
    capabilities:
      drop: ["ALL"]
  mounts:
    varlog: false
    dockercontainers: false
    extra:
      - name: tmp
        mountPath: /tmp
  configMap:
    create: true
    content: |
      discovery.kubernetes "kodama_pods" {
        role = "pod"
      }

      discovery.relabel "kodama_pods" {
        targets = discovery.kubernetes.kodama_pods.targets

        // Only Kodama's own namespaces are tailed: the control plane, the tenant namespaces of the contract and the
        // qualification sessions (kodama-q-<session>[-a|-b]) that the readiness and staging gates install.
        rule {
          source_labels = ["__meta_kubernetes_namespace"]
          regex         = ${jsonencode(monitored_namespace_regex)}
          action        = "keep"
        }

        rule {
          source_labels = ["__meta_kubernetes_namespace"]
          target_label  = "namespace"
        }

        rule {
          source_labels = ["__meta_kubernetes_pod_container_name"]
          target_label  = "container"
        }

        rule {
          source_labels = ["__meta_kubernetes_pod_label_kodama_optimi_com_managed_by"]
          target_label  = "managed_by"
        }

        rule {
          source_labels = ["__meta_kubernetes_pod_label_kodama_optimi_com_job"]
          target_label  = "job_name"
        }

        rule {
          source_labels = ["__meta_kubernetes_pod_name"]
          target_label  = "pod"
        }
      }

      loki.source.kubernetes "kodama_pods" {
        targets    = discovery.relabel.kodama_pods.output
        forward_to = [loki.process.kodama_metadata.receiver]
      }

      loki.process "kodama_metadata" {
        stage.json {
          expressions = {
            attempt_id = "attempt",
            level      = "level",
          }
        }

        // The control plane names the attempt "attemptId" where the step entrypoint says "attempt"; both are
        // searchable as one attempt_id. Only lines that carry the key are re-read, so a line without it keeps
        // the value the first stage found.
        stage.match {
          selector = "{container=\"server\"} |= \"attemptId\""

          stage.json {
            expressions = {
              attempt_id = "attemptId",
            }
          }
        }

        stage.structured_metadata {
          values = {
            job_name   = "",
            pod        = "",
            attempt_id = "",
          }
        }

        stage.label_drop {
          values = ["job_name", "pod", "attempt_id"]
        }

        forward_to = [loki.write.loki.receiver]
      }

      loki.write "loki" {
        endpoint {
          url = ${jsonencode(loki_push_url)}
        }
      }
