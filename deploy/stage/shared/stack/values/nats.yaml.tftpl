# NATS JetStream shared Helm values: token authentication from the kodama-nats-auth Secret.
# Plaintext on the cluster network by design for the stage (see variable nats_tls and T-106).
config:
  cluster:
    enabled: false
  jetstream:
    enabled: true
    fileStore:
      pvc:
        enabled: true
        size: 10Gi
  merge:
    authorization:
      # `<< >>` renders the value unquoted, so NATS expands the environment variable; a quoted
      # "$NATS_AUTH_TOKEN" would make that literal text the token.
      token: "<< $NATS_AUTH_TOKEN >>"

container:
  env:
    NATS_AUTH_TOKEN:
      valueFrom:
        secretKeyRef:
          name: kodama-nats-auth
          key: nats-token
  securityContext:
    runAsNonRoot: true
    runAsUser: 65532
    runAsGroup: 65532
    allowPrivilegeEscalation: false
    capabilities:
      drop: ["ALL"]

promExporter:
  enabled: true
  port: 7777

natsBox:
  enabled: false
