{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Kodama chart values",
  "description": "Strict values for the initial Kodama profile. Credentials are references only; one server replica; images pinned by digest; exactly one KMS provider.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "profile",
    "authority",
    "image",
    "securityContext",
    "installation",
    "server",
    "service",
    "secrets",
    "config",
    "migration",
    "execution"
  ],
  "definitions": {
    "secretKMS": {
      "type": ["object", "null"], "additionalProperties": false,
      "required": ["provider", "kekId", "current", "resources"],
      "properties": {
        "provider": {"enum": ["aws", "gcp", "scw"]},
        "kekId": {"type": "string", "minLength": 1},
        "current": {"type": "string", "minLength": 1},
        "resources": {"type": "object", "minProperties": 1, "maxProperties": 64, "additionalProperties": {"type": "string", "minLength": 1}},
        "startupTimeout": {"type": "string", "pattern": "^([0-9]+(\\.[0-9]+)?(ns|us|µs|ms|s|m))+$"},
        "aws": {"type": ["object", "null"], "additionalProperties": false, "required": ["region"], "properties": {"region": {"type": "string", "minLength": 1}}},
        "scw": {"type": ["object", "null"], "additionalProperties": false, "required": ["credentialsSecret"], "properties": {"credentialsSecret": {"$ref": "#/definitions/secretName"}}}
      },
      "oneOf": [
        {"properties": {"provider": {"const": "aws"}, "aws": {"type": "object"}, "scw": {"type": "null"}}, "required": ["aws"]},
        {"properties": {"provider": {"const": "gcp"}, "aws": {"type": "null"}, "scw": {"type": "null"}}},
        {"properties": {"provider": {"const": "scw"}, "scw": {"type": "object"}, "aws": {"type": "null"}}, "required": ["scw"]}
      ]
    },
    "dnsLabel": {
      "type": "string",
      "minLength": 1,
      "maxLength": 63,
      "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
    },
    "secretName": {
      "description": "Name of an existing Kubernetes Secret. Never a credential value.",
      "type": "string",
      "minLength": 1,
      "maxLength": 253,
      "pattern": "^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$"
    },
    "fileName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 253,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "quantity": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0
        },
        {
          "type": "string",
          "pattern": "^[0-9]+(\\.[0-9]+)?(m|k|M|G|T|Ki|Mi|Gi|Ti)?$"
        }
      ]
    },
    "storageQuantity": {
      "type": "string",
      "pattern": "^[0-9]+(\\.[0-9]+)?(k|M|G|T|Ki|Mi|Gi|Ti)$"
    },
    "digest": {
      "description": "OCI content digest. Placeholders in the examples must be overridden.",
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "imageTag": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_][A-Za-z0-9._-]{0,127}$",
      "not": {
        "const": "latest"
      }
    },
    "pinnedImage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "digest"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:/-]*$",
          "not": {
            "pattern": "[@]"
          }
        },
        "tag": {
          "$ref": "#/definitions/imageTag"
        },
        "digest": {
          "$ref": "#/definitions/digest"
        },
        "pullPolicy": {
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      }
    },
    "resourceMap": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cpu": {
          "$ref": "#/definitions/quantity"
        },
        "memory": {
          "$ref": "#/definitions/quantity"
        },
        "ephemeral-storage": {
          "$ref": "#/definitions/quantity"
        }
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requests",
        "limits"
      ],
      "properties": {
        "requests": {
          "$ref": "#/definitions/resourceMap"
        },
        "limits": {
          "$ref": "#/definitions/resourceMap"
        }
      }
    },
    "annotations": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "endpointUrl": {
      "description": "Endpoint URL without embedded userinfo (credentials never belong in values).",
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9+.-]*://[^@\\s]+$"
    },
    "probe": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "periodSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 300
        },
        "failureThreshold": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        }
      }
    },
    "egressPort": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "port"
      ],
      "properties": {
        "port": {
          "description": "PostgreSQL, PgBouncer and NATS ports are never reachable from tenant namespaces.",
          "type": "integer",
          "minimum": 1,
          "maximum": 65535,
          "not": {
            "enum": [
              5432,
              6432,
              4222,
              6222,
              8222
            ]
          }
        },
        "protocol": {
          "enum": [
            "TCP",
            "UDP"
          ]
        }
      }
    },
    "cidr": {
      "type": "string",
      "pattern": "^[0-9a-fA-F:.]+/[0-9]{1,3}$"
    },
    "egressRule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "cidr",
        "ports"
      ],
      "properties": {
        "name": {
          "$ref": "#/definitions/dnsLabel"
        },
        "cidr": {
          "$ref": "#/definitions/cidr"
        },
        "except": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/cidr"
          }
        },
        "ports": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/egressPort"
          }
        }
      }
    },
    "scaleRegion": {
      "enum": [
        "fr-par",
        "nl-ams",
        "pl-waw"
      ]
    }
  },
  "properties": {
    "nameOverride": {
      "type": "string",
      "maxLength": 63
    },
    "fullnameOverride": {
      "type": "string",
      "maxLength": 63
    },
    "profile": {
      "description": "development permits plaintext in-cluster fixtures and the keyfile KEK; external requires TLS endpoints and a cloud KMS.",
      "enum": [
        "development",
        "external"
      ]
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode"
      ],
      "properties": {
        "mode": {
          "description": "hosted is unsupported until T-061 and fails rendering; there is no fallback.",
          "enum": [
            "standalone",
            "hosted"
          ]
        }
      }
    },
    "installation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id"
      ],
      "description": "Identity of this installation. The id binds envelope-encryption contexts and must stay stable for the life of the installation.",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 63,
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
        }
      }
    },
    "image": {
      "$ref": "#/definitions/pinnedImage"
    },
    "imagePullSecrets": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/secretName"
      }
    },
    "securityContext": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runAsUser",
        "runAsGroup",
        "runAsNonRoot",
        "privileged",
        "allowPrivilegeEscalation",
        "readOnlyRootFilesystem"
      ],
      "properties": {
        "runAsUser": {
          "type": "integer",
          "minimum": 1
        },
        "runAsGroup": {
          "type": "integer",
          "minimum": 1
        },
        "runAsNonRoot": {
          "const": true
        },
        "privileged": {
          "const": false
        },
        "allowPrivilegeEscalation": {
          "const": false
        },
        "readOnlyRootFilesystem": {
          "const": true
        }
      }
    },
    "serviceAccounts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "server": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "annotations": {
              "$ref": "#/definitions/annotations"
            }
          }
        },
        "migration": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "annotations": {
              "$ref": "#/definitions/annotations"
            }
          }
        },
        "mcp": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "annotations": {
              "$ref": "#/definitions/annotations"
            }
          }
        }
      }
    },
    "server": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "replicaCount",
        "port",
        "logLevel",
        "shutdownTimeout",
        "terminationGracePeriodSeconds",
        "resources"
      ],
      "properties": {
        "replicaCount": {
          "const": 1
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "logLevel": {
          "description": "Go slog textual level (case-insensitive); numeric offsets such as INFO+2 are accepted by the process.",
          "type": "string",
          "pattern": "^(?i:debug|info|warn|error)([+-][0-9]+)?$"
        },
        "shutdownTimeout": {
          "description": "Go duration greater than zero and at most 1m (validated by the process).",
          "type": "string",
          "pattern": "^([0-9]+(\\.[0-9]+)?(ms|s|m))+$"
        },
        "terminationGracePeriodSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 600
        },
        "tmpSizeLimit": {
          "$ref": "#/definitions/storageQuantity"
        },
        "resources": {
          "$ref": "#/definitions/resources"
        },
        "probes": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "liveness": {
              "$ref": "#/definitions/probe"
            },
            "readiness": {
              "$ref": "#/definitions/probe"
            }
          }
        },
        "podAnnotations": {
          "$ref": "#/definitions/annotations"
        }
      }
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "port"
      ],
      "properties": {
        "type": {
          "enum": [
            "ClusterIP",
            "NodePort",
            "LoadBalancer"
          ]
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        }
      }
    },
    "ingress": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "className": {
          "type": "string"
        },
        "host": {
          "type": "string"
        },
        "annotations": {
          "$ref": "#/definitions/annotations"
        },
        "tls": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "secretName": {
              "type": "string"
            }
          }
        }
      },
      "if": {
        "properties": {
          "enabled": {
            "const": true
          }
        },
        "required": [
          "enabled"
        ]
      },
      "then": {
        "required": [
          "host"
        ],
        "properties": {
          "host": {
            "type": "string",
            "minLength": 1
          },
          "tls": {
            "if": {
              "properties": {
                "enabled": {
                  "const": true
                }
              },
              "required": [
                "enabled"
              ]
            },
            "then": {
              "required": [
                "secretName"
              ],
              "properties": {
                "secretName": {
                  "$ref": "#/definitions/secretName"
                }
              }
            }
          }
        }
      }
    },
    "mcp": {
      "$ref": "#/definitions/mcp"
    },
    "secrets": {
      "type": "object",
      "additionalProperties": false,
      "oneOf": [
        {"properties": {"adapter": {"const": "keyfile"}, "keyfile": {"type": "object"}, "kms": {"type": "null"}}, "required": ["keyfile"]},
        {"properties": {"adapter": {"const": "kms"}, "kms": {"type": "object"}, "keyfile": {"maxProperties": 0}}, "required": ["kms"]}
      ],
      "required": [
        "adapter",
        "runtime",
        "migration"
      ],
      "properties": {
        "adapter": {"enum": ["keyfile", "kms"]},
        "keyfile": {
          "type": ["object", "null"], "additionalProperties": false,
          "anyOf": [{"maxProperties": 0}, {"required": ["current", "files"]}],
          "properties": {
            "current": {"type": "string", "minLength": 1},
            "files": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string", "pattern": "^/secrets/[A-Za-z0-9._-]+$"}}
          }
        },
        "kms": {"$ref": "#/definitions/secretKMS"},
        "runtime": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "existingSecret"
          ],
          "properties": {
            "existingSecret": {
              "$ref": "#/definitions/secretName"
            }
          }
        },
        "migration": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "existingSecret"
          ],
          "properties": {
            "existingSecret": {
              "$ref": "#/definitions/secretName"
            }
          }
        }
      }
    },
    "config": {
      "description": "Non-secret integration wiring. Names are provisional (pending T-027 composition).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "nats",
        "s3",
        "git",
        "registry",
        "oidc",
        "tls"
      ],
      "properties": {
        "nats": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "url"
          ],
          "properties": {
            "url": {
              "$ref": "#/definitions/endpointUrl"
            }
          }
        },
        "s3": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "endpoint",
            "region",
            "bucket",
            "credentials"
          ],
          "properties": {
            "endpoint": {
              "$ref": "#/definitions/endpointUrl"
            },
            "region": {
              "type": "string",
              "minLength": 1
            },
            "bucket": {
              "type": "string",
              "minLength": 3,
              "maxLength": 63
            },
            "prefix": {
              "type": "string"
            },
            "pathStyle": {
              "type": "boolean"
            },
            "credentials": {
              "enum": [
                "static",
                "workloadIdentity"
              ]
            }
          }
        },
        "git": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "url"
          ],
          "properties": {
            "url": {
              "$ref": "#/definitions/endpointUrl"
            }
          }
        },
        "registry": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "url"
          ],
          "properties": {
            "url": {
              "$ref": "#/definitions/endpointUrl"
            }
          }
        },
        "oidc": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "issuer",
            "audience"
          ],
          "properties": {
            "issuer": {
              "$ref": "#/definitions/endpointUrl"
            },
            "audience": {
              "type": "string",
              "minLength": 1,
              "not": {
                "pattern": "@"
              }
            },
            "cliClientId": {
              "type": "string",
              "minLength": 1
            },
            "redirectUri": {
              "$ref": "#/definitions/endpointUrl"
            }
          }
        },
        "tls": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "customCA": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "migration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "args",
        "backoffLimit",
        "activeDeadlineSeconds",
        "resources",
        "runtimeRole"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "command": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "args": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "backoffLimit": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "activeDeadlineSeconds": {
          "type": "integer",
          "minimum": 30
        },
        "resources": {
          "$ref": "#/definitions/resources"
        },
        "runtimeRole": {
          "description": "Name of the PostgreSQL runtime role the migrations grant minimal access to. A name, never the runtime credential: the migration Job must not hold it.",
          "type": "string",
          "minLength": 1,
          "maxLength": 63,
          "pattern": "^[a-z_][a-z0-9_]*$"
        }
      }
    },
    "runShared": {
      "description": "The run_shared model (O-30): one disposable workspace per run, run-scoped services, ko/Buildah as ordinary steps. Disabled by default; see docs/operations/run-shared.md.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "admission": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "runShared",
            "legacyFormat"
          ],
          "properties": {
            "runShared": {
              "enum": [
                "closed",
                "open"
              ]
            },
            "legacyFormat": {
              "enum": [
                "open",
                "drain",
                "closed"
              ]
            }
          }
        },
        "identity": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "runAsUser",
            "runAsGroup",
            "fsGroup"
          ],
          "properties": {
            "runAsUser": {
              "type": "integer",
              "minimum": 1
            },
            "runAsGroup": {
              "type": "integer",
              "minimum": 1
            },
            "fsGroup": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "podSecurity": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "version"
          ],
          "properties": {
            "version": {
              "type": "string",
              "pattern": "^v1\\.[0-9]{1,2}$",
              "description": "The pinned Pod Security version of the tenant namespaces and the execution policy; `latest` is never accepted."
            }
          }
        },
        "clusterCIDRs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[0-9]{1,3}(\\.[0-9]{1,3}){3}/([1-9]|[12][0-9]|3[0-2])$"
          }
        },
        "nodeProfilesInstalled": {
          "type": "boolean",
          "description": "Operator attestation that the step role's node profiles are installed on every worker node."
        },
        "builderRootless": {
          "type": "boolean"
        },
        "quota": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "persistentvolumeclaims": {
              "type": "integer",
              "minimum": 1
            },
            "requests.storage": {
              "$ref": "#/definitions/storageQuantity"
            },
            "services": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "policy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "limits",
            "workspace",
            "roles",
            "builders",
            "network"
          ],
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9._-]{0,62}$"
            },
            "limits": {
              "type": "object",
              "additionalProperties": false,
              "minProperties": 17,
              "properties": {
                "maxRunSeconds": {
                  "type": "integer",
                  "minimum": 1
                },
                "maxServices": {
                  "type": "integer",
                  "minimum": 1
                },
                "maxRunWorkspaceMiB": {
                  "type": "integer",
                  "minimum": 1
                },
                "defaultRunWorkspaceMiB": {
                  "type": "integer",
                  "minimum": 1
                },
                "maxServiceCpuMillis": {
                  "type": "integer",
                  "minimum": 1
                },
                "maxServiceMemoryMiB": {
                  "type": "integer",
                  "minimum": 1
                },
                "maxServiceEphemeralMiB": {
                  "type": "integer",
                  "minimum": 1
                },
                "maxServiceStorageMiB": {
                  "type": "integer",
                  "minimum": 1
                },
                "preparationTimeoutSeconds": {
                  "type": "integer",
                  "minimum": 1
                },
                "preparationAttempts": {
                  "type": "integer",
                  "minimum": 1
                },
                "preparationMaxBytes": {
                  "type": "integer",
                  "minimum": 1
                },
                "stopGraceSeconds": {
                  "type": "integer",
                  "minimum": 1
                },
                "preparationCpuMillis": {
                  "type": "integer",
                  "minimum": 1
                },
                "preparationMemoryMiB": {
                  "type": "integer",
                  "minimum": 1
                },
                "stepCpuMillis": {
                  "type": "integer",
                  "minimum": 1
                },
                "stepMemoryMiB": {
                  "type": "integer",
                  "minimum": 1
                },
                "stepEphemeralMiB": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            },
            "requires": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "enum": [
                  "builder_rootless"
                ]
              }
            },
            "workspace": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "storageClass",
                "idmapped"
              ],
              "properties": {
                "storageClass": {
                  "type": "string",
                  "pattern": "^[a-z0-9]([-a-z0-9.]{0,251}[a-z0-9])?$"
                },
                "idmapped": {
                  "type": "boolean"
                }
              }
            },
            "roles": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "step"
              ],
              "properties": {
                "step": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "capabilitiesAdd",
                    "seccomp",
                    "lsm"
                  ],
                  "properties": {
                    "capabilitiesAdd": {
                      "type": "array",
                      "uniqueItems": true,
                      "items": {
                        "enum": [
                          "SETUID",
                          "SETGID"
                        ]
                      }
                    },
                    "seccomp": {
                      "type": "string",
                      "pattern": "^(RuntimeDefault|[a-z0-9][a-z0-9._-]{0,62})$"
                    },
                    "lsm": {
                      "type": "string",
                      "pattern": "^([a-z0-9][a-z0-9._-]{0,62})?$"
                    },
                    "procMount": {
                      "enum": [
                        "",
                        "unmasked"
                      ]
                    }
                  }
                },
                "preparationImage": {
                  "anyOf": [
                    {
                      "type": "string",
                      "maxLength": 0
                    },
                    {
                      "type": "string",
                      "pattern": "^[^\\s@]+@sha256:[a-f0-9]{64}$"
                    }
                  ]
                }
              }
            },
            "builders": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "rootless"
              ],
              "properties": {
                "rootless": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": {
                    "enum": [
                      "ko",
                      "buildah"
                    ]
                  }
                }
              }
            },
            "network": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "isolation",
                "publicEgress"
              ],
              "properties": {
                "isolation": {
                  "enum": [
                    "tenant",
                    "run"
                  ]
                },
                "publicEgress": {
                  "type": "boolean"
                }
              }
            },
            "egressProfiles": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "destinations"
                ],
                "properties": {
                  "destinations": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "host",
                        "ports"
                      ],
                      "properties": {
                        "host": {
                          "type": "string",
                          "minLength": 1
                        },
                        "ports": {
                          "type": "array",
                          "minItems": 1,
                          "items": {
                            "type": "integer",
                            "minimum": 1,
                            "maximum": 65535
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "retainedPolicies": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true,
            "required": [
              "id"
            ],
            "properties": {
              "id": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "trustProfile",
        "serviceAccountName",
        "tenants",
        "entrypoint",
        "volumes",
        "job",
        "exampleJob",
        "quota",
        "limitRange",
        "network",
        "rbac",
        "runtime"
      ],
      "properties": {
        "trustProfile": {
          "description": "Trusted-engineer only. Untrusted hosted isolation is a separate, release-gated profile (T-055/T-056).",
          "const": "trusted-engineer"
        },
        "serviceAccountName": {
          "$ref": "#/definitions/dnsLabel"
        },
        "tenants": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "namespace",
              "tenantId"
            ],
            "properties": {
              "namespace": {
                "type": "string",
                "maxLength": 63,
                "pattern": "^kodama-[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
              },
              "tenantId": {
                "description": "The Kodama tenant whose attempts run in this namespace (one tenant per namespace).",
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
              }
            }
          }
        },
        "entrypoint": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sourcePath"
          ],
          "properties": {
            "sourcePath": {
              "type": "string",
              "pattern": "^/[^\\s]+$"
            },
            "copyCommand": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "volumes": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "workspaceSizeLimit",
            "outputsSizeLimit",
            "secretsSizeLimit",
            "identitySizeLimit",
            "toolsSizeLimit",
            "scratchSizeLimit",
            "resultsSizeLimit"
          ],
          "properties": {
            "workspaceSizeLimit": {
              "$ref": "#/definitions/storageQuantity"
            },
            "outputsSizeLimit": {
              "$ref": "#/definitions/storageQuantity"
            },
            "secretsSizeLimit": {
              "$ref": "#/definitions/storageQuantity"
            },
            "identitySizeLimit": {
              "$ref": "#/definitions/storageQuantity"
            },
            "toolsSizeLimit": {
              "$ref": "#/definitions/storageQuantity"
            },
            "scratchSizeLimit": {
              "$ref": "#/definitions/storageQuantity"
            },
            "resultsSizeLimit": {
              "$ref": "#/definitions/storageQuantity"
            }
          }
        },
        "job": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "activeDeadlineSeconds",
            "runAsUser",
            "runAsGroup",
            "resources",
            "injectorResources",
            "terminationGracePeriodSeconds"
          ],
          "properties": {
            "activeDeadlineSeconds": {
              "type": "integer",
              "minimum": 30
            },
            "runAsUser": {
              "type": "integer",
              "minimum": 1
            },
            "runAsGroup": {
              "type": "integer",
              "minimum": 1
            },
            "resources": {
              "$ref": "#/definitions/resources"
            },
            "injectorResources": {
              "$ref": "#/definitions/resources"
            },
            "terminationGracePeriodSeconds": {
              "type": "integer",
              "minimum": 1,
              "maximum": 600
            }
          }
        },
        "exampleJob": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "image"
          ],
          "properties": {
            "image": {
              "$ref": "#/definitions/pinnedImage"
            }
          }
        },
        "quota": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "pods": {
              "type": "integer",
              "minimum": 1
            },
            "count/jobs.batch": {
              "type": "integer",
              "minimum": 1
            },
            "requests.cpu": {
              "$ref": "#/definitions/quantity"
            },
            "requests.memory": {
              "$ref": "#/definitions/quantity"
            },
            "requests.ephemeral-storage": {
              "$ref": "#/definitions/quantity"
            },
            "limits.cpu": {
              "$ref": "#/definitions/quantity"
            },
            "limits.memory": {
              "$ref": "#/definitions/quantity"
            },
            "limits.ephemeral-storage": {
              "$ref": "#/definitions/quantity"
            }
          }
        },
        "limitRange": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "default",
            "defaultRequest",
            "max"
          ],
          "properties": {
            "default": {
              "$ref": "#/definitions/resourceMap"
            },
            "defaultRequest": {
              "$ref": "#/definitions/resourceMap"
            },
            "max": {
              "$ref": "#/definitions/resourceMap"
            }
          }
        },
        "network": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "egress"
          ],
          "properties": {
            "egress": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/egressRule"
              }
            }
          }
        },
        "rbac": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "manageSecrets"
          ],
          "properties": {
            "manageSecrets": {
              "type": "boolean"
            }
          }
        },
        "runtime": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "url",
            "signingGeneration",
            "egress"
          ],
          "description": "The runtime API as tenant workloads reach it. The server itself serves plain HTTP: url must be an https origin that terminates TLS in front of it (ingress, mesh), which is outside this chart. The trust roots workloads use for url are the runtime-ca.crt file of the runtime Secret.",
          "properties": {
            "url": {
              "type": "string",
              "pattern": "^https://[^@\\s/]+$"
            },
            "signingGeneration": {
              "type": "integer",
              "minimum": 1,
              "description": "Generation of the runtime-signing-key in the runtime Secret; never reused for another key."
            },
            "egress": {
              "type": "array",
              "minItems": 1,
              "description": "The only destinations workloads may reach for the callback.",
              "items": {
                "$ref": "#/definitions/egressRule"
              }
            }
          }
        }
      }
    },
    "mcp": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "replicaCount", "port", "service", "exchange", "resources"],
      "properties": {
        "enabled": {"type": "boolean"},
        "replicaCount": {"type": "integer", "minimum": 1, "maximum": 5},
        "port": {"type": "integer", "minimum": 1, "maximum": 65535},
        "tmpSizeLimit": {"$ref": "#/definitions/storageQuantity"},
        "service": {
          "type": "object", "additionalProperties": false, "required": ["type", "port"],
          "properties": {
            "type": {"enum": ["ClusterIP"]},
            "port": {"type": "integer", "minimum": 1, "maximum": 65535}
          }
        },
        "apiURL": {"type": "string"},
        "resource": {"type": "string"},
        "audience": {"type": "string"},
        "issuer": {"type": "string"},
        "apiAudience": {"type": "string"},
        "apiIssuer": {"type": "string"},
        "apiResource": {"type": "string"},
        "exchange": {
          "type": "object", "additionalProperties": false,
          "required": ["url", "clientId", "clientAuth", "existingSecret", "secretKey"],
          "properties": {
            "url": {"type": "string"},
            "clientId": {"type": "string"},
            "clientAuth": {"enum": ["client_secret_basic", "client_secret_post"]},
            "existingSecret": {"anyOf": [{"const": ""}, {"$ref": "#/definitions/secretName"}]},
            "secretKey": {"$ref": "#/definitions/fileName"},
            "scopes": {"type": "string"},
            "caSecret": {"anyOf": [{"const": ""}, {"$ref": "#/definitions/secretName"}]},
            "caKey": {"$ref": "#/definitions/fileName"}
          }
        },
        "scopes": {"type": "string"},
        "readOnly": {"type": "boolean"},
        "toolsets": {"type": "string"},
        "enableSecretWrites": {"type": "boolean"},
        "enableCredentialTools": {"type": "boolean"},
        "allowInsecureHTTP": {"type": "boolean"},
        "allowInsecureAPIHTTP": {"type": "boolean"},
        "caSecret": {"anyOf": [{"const": ""}, {"$ref": "#/definitions/secretName"}]},
        "caKey": {"$ref": "#/definitions/fileName"},
        "ingress": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "enabled": {"type": "boolean"},
            "className": {"type": "string"},
            "host": {"type": "string"},
            "path": {"type": "string", "pattern": "^/"},
            "annotations": {"$ref": "#/definitions/annotations"},
            "tls": {
              "type": "object", "additionalProperties": false,
              "properties": {
                "enabled": {"type": "boolean"},
                "secretName": {"type": "string"}
              },
              "if": {"properties": {"enabled": {"const": true}}, "required": ["enabled"]},
              "then": {
                "required": ["secretName"],
                "properties": {"secretName": {"$ref": "#/definitions/secretName"}}
              }
            }
          },
          "if": {"properties": {"enabled": {"const": true}}, "required": ["enabled"]},
          "then": {
            "required": ["host"],
            "properties": {
              "host": {"type": "string", "minLength": 1}
            }
          }
        },
        "resources": {"$ref": "#/definitions/resources"},
        "probes": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "liveness": {"$ref": "#/definitions/probe"},
            "readiness": {"$ref": "#/definitions/probe"}
          }
        },
        "podAnnotations": {"$ref": "#/definitions/annotations"}
      }
    }
  },
  "allOf": [
    {
      "description": "The external profile requires TLS endpoints and forbids the development keyfile provider.",
      "if": {
        "properties": {
          "profile": {
            "const": "external"
          }
        },
        "required": [
          "profile"
        ]
      },
      "then": {
        "properties": {
          "secrets": {
            "properties": {
              "adapter": {"const": "kms"}
            }
          },
          "config": {
            "properties": {
              "nats": {
                "properties": {
                  "url": {
                    "pattern": "^tls://"
                  }
                }
              },
              "s3": {
                "properties": {
                  "endpoint": {
                    "pattern": "^https://"
                  }
                }
              },
              "git": {
                "properties": {
                  "url": {
                    "pattern": "^https://"
                  }
                }
              },
              "registry": {
                "properties": {
                  "url": {
                    "pattern": "^https://"
                  }
                }
              },
              "oidc": {
                "properties": {
                  "issuer": {
                    "pattern": "^https://"
                  }
                }
              }
            }
          }
        }
      }
    }
  ]
}
