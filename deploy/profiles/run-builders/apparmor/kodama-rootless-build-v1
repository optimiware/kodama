# kodama-rootless-build-v1 (profile version 1)
#
# Derived from the containerd default container profile (template
# contrib/apparmor/template.go at containerd v2.3.6, the version the stage nodes run).
# Deviations from that template, each deliberate:
#   * abi <abi/4.0>   (the template uses abi/3.0, which has no `userns` class).
#   * userns,         permits creating user namespaces; on Ubuntu 24.04 with
#                     kernel.apparmor_restrict_unprivileged_userns=1 this rule is what lets
#                     a confined process create one.
#   * `deny mount,` replaced by mount/remount/umount/pivot_root rules, which the kernel
#     only honours for namespaces the caller owns (nested user namespace); without
#     CAP_SYS_ADMIN in a user namespace the process cannot mount anything.
#   * unix,           the abi/4.0 `unix` class is mediated separately from `network,`; the
#                     template's abi/3.0 does not mediate it, so it is allowed to keep parity.
#   * The daemon and rootlesskit signal peers are fixed (`unconfined` is already allowed;
#     no rootlesskit on the nodes) because this file is installed verbatim, not templated.
# Everything else, including the denials of host /proc, /sys and kcore writes, is unchanged.
abi <abi/4.0>,

#include <tunables/global>

profile kodama-rootless-build-v1 flags=(attach_disconnected,mediate_deleted) {
  #include <abstractions/base>

  network,
  unix,
  capability,
  file,
  userns,

  # Mounts happen only inside the build's own user+mount namespace.
  mount,
  remount,
  umount,
  pivot_root,

  # Host (privileged) processes may send signals to container processes.
  signal (receive) peer=unconfined,
  # runc may send signals to container processes.
  signal (receive) peer=runc,
  # crun may send signals to container processes.
  signal (receive) peer=crun,
  # Container processes may send signals amongst themselves.
  signal (send,receive) peer=kodama-rootless-build-v1,

  deny @{PROC}/* w,   # deny write for all files directly in /proc (not in a subdir)
  # deny write to files not in /proc/<number>/** or /proc/sys/**
  deny @{PROC}/{[^1-9/],[^1-9/][^0-9/],[^1-9s/][^0-9y/][^0-9s/],[^1-9/][^0-9/][^0-9/][^0-9/]*}/** w,
  deny @{PROC}/sys/[^k]** w,  # deny /proc/sys except /proc/sys/k* (effectively /proc/sys/kernel)
  deny @{PROC}/sys/kernel/{?,??,[^s][^h][^m]**} w,  # deny everything except shm* in /proc/sys/kernel/
  deny @{PROC}/sysrq-trigger rwklx,
  deny @{PROC}/kcore rwklx,

  deny /sys/[^f]*/** wklx,
  deny /sys/f[^s]*/** wklx,
  deny /sys/fs/[^c]*/** wklx,
  deny /sys/fs/c[^g]*/** wklx,
  deny /sys/fs/cg[^r]*/** wklx,
  deny /sys/firmware/** rwklx,
  deny /sys/devices/virtual/powercap/** rwklx,
  deny /sys/kernel/security/** rwklx,

  # allow processes within the container to trace each other,
  # provided all other LSM and yama setting allow it.
  ptrace (trace,tracedby,read,readby) peer=kodama-rootless-build-v1,
}
