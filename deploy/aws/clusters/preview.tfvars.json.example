{
  "cluster_name": "preview",
  "environment": "production",
  "cost_profile": "cost-conscious",
  "region": "eu-west-1",
  "release_namespace": "kodama-system",
  "tenants": [
    "tenant-a"
  ],
  "eks_version": "1.35",
  "eks_instance_types": [
    "t3.medium"
  ],
  "eks_desired_size": 1,
  "k8s_api_allowed_cidrs": [
    "203.0.113.7/32"
  ],
  "postgres_engine_version": "16",
  "postgres_instance_class": "db.t4g.small",
  "postgres_allocated_storage_gb": 20,
  "postgres_skip_final_snapshot": true
}
