{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Kodama kernel chart values",
  "type": "object",
  "additionalProperties": false,
  "required": ["installation", "image", "securityContext", "server", "service", "publicURL", "nats", "oidc", "secrets", "kms", "execution", "persistence", "git", "migration"],
  "definitions": {
    "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "image": {
      "type": "object", "additionalProperties": false, "required": ["repository", "digest"],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "tag": {"type": "string", "minLength": 1},
        "digest": {"$ref": "#/definitions/digest"},
        "pullPolicy": {"enum": ["Always", "IfNotPresent", "Never"]}
      }
    },
    "secretName": {"type": "string", "minLength": 1, "maxLength": 253},
    "quantity": {"type": "string", "pattern": "^[0-9]+(\\.[0-9]+)?(m|k|M|G|T|Ki|Mi|Gi|Ti)?$"},
    "storage": {"type": "string", "pattern": "^[0-9]+(\\.[0-9]+)?(k|M|G|T|Ki|Mi|Gi|Ti)$"},
    "cidr": {"type": "string", "pattern": "^[0-9a-fA-F:.]+/[0-9]{1,3}$"},
    "tenant": {
      "type": "object", "additionalProperties": false, "required": ["namespace", "tenantId"],
      "properties": {
        "namespace": {"type": "string", "pattern": "^kodama-[a-z0-9-]{1,55}$"},
        "tenantId": {"type": "string", "minLength": 1, "maxLength": 128}
      }
    }
  },
  "properties": {
    "nameOverride": {"type": "string", "maxLength": 63},
    "fullnameOverride": {"type": "string", "maxLength": 63},
    "installation": {"type": "object", "additionalProperties": false, "required": ["id"], "properties": {"id": {"type": "string", "minLength": 1, "maxLength": 63, "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"}}},
    "image": {"$ref": "#/definitions/image"},
    "imagePullSecrets": {"type": "array", "items": {"type": "string"}},
    "securityContext": {"type": "object", "additionalProperties": false, "required": ["runAsUser", "runAsGroup", "runAsNonRoot", "privileged", "allowPrivilegeEscalation", "readOnlyRootFilesystem"], "properties": {
      "runAsUser": {"type": "integer", "minimum": 1}, "runAsGroup": {"type": "integer", "minimum": 1},
      "runAsNonRoot": {"const": true}, "privileged": {"const": false}, "allowPrivilegeEscalation": {"const": false}, "readOnlyRootFilesystem": {"const": true}
    }},
    "serviceAccounts": {"type": "object", "additionalProperties": false, "properties": {"server": {"type": "object", "properties": {"annotations": {"type": "object", "additionalProperties": {"type": "string"}}}}, "migration": {"type": "object", "properties": {"annotations": {"type": "object", "additionalProperties": {"type": "string"}}}}}},
    "server": {"type": "object", "additionalProperties": false, "properties": {
      "port": {"type": "integer", "minimum": 1, "maximum": 65535},
      "logLevel": {"type": "string"}, "shutdownTimeout": {"type": "string"}, "terminationGracePeriodSeconds": {"type": "integer", "minimum": 1},
      "tmpSizeLimit": {"$ref": "#/definitions/storage"},
      "resources": {"type": "object"}, "probes": {"type": "object"}, "podAnnotations": {"type": "object", "additionalProperties": {"type": "string"}}
    }},
    "service": {"type": "object", "additionalProperties": false, "required": ["port"], "properties": {"type": {"enum": ["ClusterIP", "NodePort", "LoadBalancer"]}, "port": {"type": "integer", "minimum": 1, "maximum": 65535}}},
    "ingress": {"type": "object", "additionalProperties": false, "properties": {"enabled": {"type": "boolean"}, "className": {"type": "string"}, "host": {"type": "string"}, "annotations": {"type": "object", "additionalProperties": {"type": "string"}}, "tls": {"type": "object", "additionalProperties": false, "properties": {"enabled": {"type": "boolean"}, "secretName": {"type": "string"}}}}},
    "publicURL": {"type": "string", "pattern": "^https://[^@\\s]+$"},
    "nats": {"type": "object", "additionalProperties": false, "required": ["url"], "properties": {"url": {"type": "string", "pattern": "^(nats|tls)://[^@\\s]+$"}}},
    "oidc": {"type": "object", "additionalProperties": false, "required": ["issuer", "clientId"], "properties": {"issuer": {"type": "string", "pattern": "^https://[^@\\s]+$"}, "clientId": {"type": "string", "minLength": 1}}},
    "secrets": {"type": "object", "additionalProperties": false, "required": ["runtime", "migration", "kms"], "properties": {
      "runtime": {"type": "object", "additionalProperties": false, "required": ["existingSecret"], "properties": {"existingSecret": {"$ref": "#/definitions/secretName"}}},
      "migration": {"type": "object", "additionalProperties": false, "required": ["existingSecret"], "properties": {"existingSecret": {"$ref": "#/definitions/secretName"}}},
      "kms": {"type": "object", "additionalProperties": false, "required": ["existingSecret"], "properties": {"existingSecret": {"$ref": "#/definitions/secretName"}}}
    }},
    "kms": {"type": "object", "additionalProperties": false, "required": ["provider", "current", "resources"], "properties": {
      "provider": {"enum": ["scw", "aws", "gcp"]}, "current": {"type": "string", "minLength": 1},
      "resources": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string", "minLength": 1}},
      "startupTimeout": {"type": "string"},
      "scw": {"type": "object", "additionalProperties": false, "properties": {"credentialsFile": {"type": "string"}}},
      "aws": {"type": "object", "additionalProperties": false, "properties": {"region": {"type": "string"}}},
      "gcp": {"type": "object", "additionalProperties": false}
    }},
    "execution": {"type": "object", "additionalProperties": false, "required": ["storageClass", "tenants", "checkoutImage"], "properties": {
      "storageClass": {"type": "string", "minLength": 1}, "workspaceSize": {"$ref": "#/definitions/storage"},
      "runAsUser": {"type": "integer", "minimum": 1}, "runAsGroup": {"type": "integer", "minimum": 1},
      "pullPolicy": {"enum": ["Always", "IfNotPresent", "Never"]}, "serviceAccountName": {"type": "string", "minLength": 1},
      "checkoutImage": {"$ref": "#/definitions/image"},
      "tenants": {"type": "array", "minItems": 1, "items": {"$ref": "#/definitions/tenant"}},
      "network": {"type": "object", "additionalProperties": false, "properties": {"dnsNamespace": {"type": "string"}, "publicExcept": {"type": "array", "items": {"$ref": "#/definitions/cidr"}}}},
      "quota": {"type": "object", "additionalProperties": {"$ref": "#/definitions/quantity"}},
      "limitRange": {"type": "object"}
    }},
    "persistence": {"type": "object", "additionalProperties": false, "properties": {"enabled": {"type": "boolean"}, "existingClaim": {"type": "string"}, "storageClass": {"type": "string"}, "size": {"$ref": "#/definitions/storage"}}},
    "git": {"type": "object", "additionalProperties": false, "properties": {"hosting": {"enum": ["embedded"]}, "embeddedAck": {"const": "stage-only"}, "pollInterval": {"type": "string"}}},
    "migration": {"type": "object", "additionalProperties": false, "properties": {"enabled": {"type": "boolean"}, "args": {"type": "array", "items": {"type": "string"}}, "runtimeRole": {"type": "string"}, "backoffLimit": {"type": "integer"}, "activeDeadlineSeconds": {"type": "integer"}, "resources": {"type": "object"}}}
  }
}
