# T-089 workload fixture image: a minimal shell userland. The entrypoint binary
# is injected by the init container, never baked in. The base is pinned by
# digest; the locally built image is then pinned by the digest of its OCI
# archive index (see cluster_test.go).
FROM docker.io/library/alpine:3.22@sha256:5291449c3df73caf6ed85e649dec1b9e818b39a5d8c871e97afc13e9cd5e8fa8
LABEL io.kodama.t089.role=workload
