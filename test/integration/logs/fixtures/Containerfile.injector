# T-064 injector fixture image: the actual entrypoint (`kodama step`, which
# mirrors redacted command output to the container log, T-078) built as a static
# binary by the fixture, plus cp for the init container.
FROM docker.io/library/alpine:3.22@sha256:5291449c3df73caf6ed85e649dec1b9e818b39a5d8c871e97afc13e9cd5e8fa8
LABEL io.kodama.t064.role=injector
COPY --chmod=0755 kodama /usr/local/bin/kodama
