# Kodama ordinary deployment tools image (task T-065).
#
# An ordinary step image, not a deployment engine: kubectl, curl, jq, git and the
# apply/lookup/delete scripts under /opt/kodama/deploy. It needs no privilege: it
# runs as an unprivileged user, writes only to its scratch directory and carries
# no container runtime, no setuid helper that is used and no credential.
#
# Every input is pinned:
#   * base: debian bookworm-slim by digest (the same base as the T-031 image);
#   * packages: installed from snapshot.debian.org at SNAPSHOT (the installed
#     versions are recorded in /opt/kodama/deploy/packages.txt);
#   * kubectl: the version and per-architecture sha256 recorded in
#     dev/versions.lock.json (a unit test keeps the two in step); the download is
#     verified inside the build and a mismatch fails it;
#   * the scripts: copied from this directory (their digest is recorded in
#     /opt/kodama/deploy/scripts.sha256 and in evidence/build.json).
#
# No ENTRYPOINT/CMD: the step entrypoint (injected by the executor) is PID 1 and
# runs one of the scripts as the step's command.
FROM docker.io/library/debian@sha256:5ae3c39ebd15e229dcedd5cee596b2497182493d41ff162e824ba13fc1b2b867

ARG SNAPSHOT=20260824T000000Z
ARG KUBECTL_VERSION=1.37.1
ARG KUBECTL_SHA256_AMD64=65691ff77eb6fa44c908b77a1082c9f092c3b9733b5cefabec0d1104890e21a8
ARG KUBECTL_SHA256_ARM64=ff749f4b78d9c4f1ec87307df9b50119ed819e2094aa9810cb9acffc3286c8c7

RUN set -eu; \
    printf 'Types: deb\nURIs: http://snapshot.debian.org/archive/debian/%s/\nSuites: bookworm bookworm-updates\nComponents: main\nSigned-By: /usr/share/keyrings/debian-archive-keyring.gpg\n\nTypes: deb\nURIs: http://snapshot.debian.org/archive/debian-security/%s/\nSuites: bookworm-security\nComponents: main\nSigned-By: /usr/share/keyrings/debian-archive-keyring.gpg\n' "$SNAPSHOT" "$SNAPSHOT" > /etc/apt/sources.list.d/debian.sources; \
    echo 'Acquire::Check-Valid-Until "false";' > /etc/apt/apt.conf.d/99snapshot; \
    apt-get update; \
    apt-get install -y --no-install-recommends git ca-certificates curl jq; \
    mkdir -p /opt/kodama/deploy; \
    dpkg-query -W -f='${Package}=${Version}\n' git ca-certificates curl jq bash coreutils sed grep findutils libc6 | sort > /opt/kodama/deploy/packages.txt; \
    arch="$(dpkg --print-architecture)"; \
    case "$arch" in amd64) want="$KUBECTL_SHA256_AMD64" ;; arm64) want="$KUBECTL_SHA256_ARM64" ;; *) echo "unsupported architecture $arch" >&2; exit 1 ;; esac; \
    curl --fail --silent --show-error --location --proto '=https' --tlsv1.2 -o /usr/local/bin/kubectl "https://dl.k8s.io/release/v${KUBECTL_VERSION}/bin/linux/${arch}/kubectl"; \
    echo "${want}  /usr/local/bin/kubectl" | sha256sum -c -; \
    chmod 0755 /usr/local/bin/kubectl; \
    rm -rf /var/lib/apt/lists/* /var/cache/apt /var/log/apt /var/log/dpkg.log /var/log/alternatives.log /var/cache/ldconfig/aux-cache

COPY scripts/ /opt/kodama/deploy/
COPY examples/ /opt/kodama/deploy/examples/
RUN set -eu; \
    chmod 0755 /opt/kodama/deploy/apply.sh /opt/kodama/deploy/lookup.sh /opt/kodama/deploy/delete.sh; \
    chmod 0644 /opt/kodama/deploy/lib.sh; \
    (cd /opt/kodama/deploy && sha256sum apply.sh lookup.sh delete.sh lib.sh > scripts.sha256); \
    printf '%s\n' "${KUBECTL_VERSION}" > /opt/kodama/deploy/kubectl.version; \
    find /opt/kodama -type d -exec chmod 0755 {} +

LABEL io.kodama.task="T-065" \
      io.kodama.tools="deployment" \
      io.kodama.kubectl.version="1.37.1"
# Scratch space is the only writable location (read-only root filesystem works);
# kubectl's discovery cache lives there too. The platform CA and the runtime token
# default to the Job recipe's paths; the platform origin is supplied by the step.
ENV TMPDIR=/tmp \
    KUBECACHEDIR=/tmp/.kube-cache \
    KODAMA_CA_FILE=/kodama/bootstrap/ca.crt \
    KODAMA_TOKEN_FILE=/kodama/identity/token
USER 65532:65532
WORKDIR /tmp
