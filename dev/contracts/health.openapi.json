{
  "openapi": "3.1.0",
  "info": {"title": "Kodama scaffold process probes", "version": "0.1.0"},
  "paths": {
    "/healthz": {
      "get": {
        "operationId": "processHealth",
        "responses": {
          "200": {"description": "Process is serving HTTP", "content": {"application/json": {"schema": {"type": "object", "required": ["status"], "additionalProperties": false, "properties": {"status": {"const": "ok"}}}}}}
        }
      }
    },
    "/readyz": {
      "get": {
        "operationId": "processReadiness",
        "description": "Process lifecycle only; dependency and dispatch readiness will be composed by later tasks.",
        "responses": {
          "200": {"description": "Process ready", "content": {"application/json": {"schema": {"type": "object", "required": ["status"], "additionalProperties": false, "properties": {"status": {"const": "ready"}}}}}},
          "503": {"description": "Process draining or not ready", "content": {"application/json": {"schema": {"type": "object", "required": ["status"], "additionalProperties": false, "properties": {"status": {"const": "not_ready"}}}}}}
        }
      }
    }
  }
}
