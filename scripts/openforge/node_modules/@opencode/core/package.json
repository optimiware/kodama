{
  "$schema": "https://json.schemastore.org/package.json",
  "version": "2.1.2",
  "name": "@opencode/core",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anomalyco/opencode.git",
    "directory": "packages/core"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "db": "bun drizzle-kit",
    "migration": "bun run script/migration.ts",
    "fix-node-pty": "bun run script/fix-node-pty.ts",
    "benchmark:location": "bun run script/benchmark-location.ts",
    "benchmark:location-memory": "bun run script/benchmark-location-memory.ts",
    "build": "bun run script/build.ts",
    "update-models-snapshot": "bun run script/update-models-snapshot.ts",
    "test": "bun run script/test.ts",
    "typecheck": "tsc -b tsconfig.json tsconfig.tests.json"
  },
  "exports": {
    "./*": {
      "import": "./dist/*.js",
      "types": "./dist/types/*.d.ts"
    }
  },
  "imports": {
    "#sqlite": {
      "workerd": "./dist/database/sqlite.workerd.js",
      "bun": "./dist/database/sqlite.bun.js",
      "node": "./dist/database/sqlite.node.js",
      "default": "./dist/database/sqlite.node.js"
    },
    "#pty": {
      "workerd": "./dist/pty/pty.workerd.js",
      "bun": "./dist/pty/pty.bun.js",
      "node": "./dist/pty/pty.node.js",
      "default": "./dist/pty/pty.bun.js"
    },
    "#persistent-pty-binary": {
      "workerd": "./dist/persistent-pty/binary.workerd.js",
      "bun": "./dist/persistent-pty/binary.bun.js",
      "node": "./dist/persistent-pty/binary.node.js",
      "default": "./dist/persistent-pty/binary.bun.js"
    },
    "#fff": {
      "workerd": "./dist/filesystem/fff.workerd.js",
      "bun": "./dist/filesystem/fff.bun.js",
      "node": "./dist/filesystem/fff.node.js",
      "default": "./dist/filesystem/fff.bun.js"
    },
    "#photon-wasm": {
      "workerd": "./dist/image/photon-wasm.workerd.js",
      "bun": "./dist/image/photon-wasm.bun.js",
      "node": "./dist/image/photon-wasm.node.js",
      "default": "./dist/image/photon-wasm.bun.js"
    },
    "#shell-parser-wasm": {
      "workerd": "./dist/shell/parser-wasm.workerd.js",
      "bun": "./dist/shell/parser-wasm.bun.js",
      "node": "./dist/shell/parser-wasm.node.js",
      "default": "./dist/shell/parser-wasm.bun.js"
    },
    "#v1-migration": {
      "types": "./dist/types/database/v1-migration.bun.d.ts",
      "bun": "./dist/database/v1-migration.bun.js",
      "node": "./dist/database/v1-migration.noop.js",
      "workerd": "./dist/database/v1-migration.noop.js",
      "default": "./dist/database/v1-migration.noop.js"
    }
  },
  "devDependencies": {
    "@ai-sdk/openai-compatible": "2.0.41",
    "@effect/platform-node": "4.0.1",
    "@effect/sql-sqlite-bun": "4.0.1",
    "@modelcontextprotocol/server": "2.0.0",
    "@opencode/http-recorder": "2.1.2",
    "@parcel/watcher-darwin-arm64": "2.5.1",
    "@parcel/watcher-darwin-x64": "2.5.1",
    "@parcel/watcher-linux-arm64-glibc": "2.5.1",
    "@parcel/watcher-linux-arm64-musl": "2.5.1",
    "@parcel/watcher-linux-x64-glibc": "2.5.1",
    "@parcel/watcher-linux-x64-musl": "2.5.1",
    "@parcel/watcher-win32-arm64": "2.5.1",
    "@parcel/watcher-win32-x64": "2.5.1",
    "@tsconfig/bun": "1.0.9",
    "@types/bun": "1.4.0",
    "@types/node": "24.12.2",
    "@types/which": "3.0.4",
    "drizzle-kit": "1.0.0-rc.5-ab785fc",
    "fast-check": "4.9.0"
  },
  "dependencies": {
    "@ai-sdk/cohere": "3.0.27",
    "@ai-sdk/perplexity": "3.0.26",
    "@ai-sdk/provider": "3.0.8",
    "@ai-sdk/provider-utils": "4.0.23",
    "@ai-sdk/vercel": "2.0.39",
    "@ff-labs/fff-bun": "0.10.5",
    "@ff-labs/fff-node": "0.10.5",
    "@lydell/node-pty": "1.2.0-beta.12",
    "@modelcontextprotocol/client": "2.0.0",
    "@modelcontextprotocol/core": "2.0.0",
    "@opencode-ai/pty": "0.3.1",
    "@opencode/ai": "2.1.2",
    "@opencode/codemode": "2.1.2",
    "@opencode/plugin": "2.1.2",
    "@opencode/plugin-browser": "2.1.2",
    "@opencode/schema": "2.1.2",
    "@opencode/util": "2.1.2",
    "@parcel/watcher": "2.5.1",
    "@silvia-odwyer/photon-node": "0.3.4",
    "@standard-schema/spec": "1.1.0",
    "bun-pty": "0.4.11",
    "diff": "8.0.4",
    "drizzle-orm": "1.0.0-rc.5-169397b",
    "effect": "4.0.1",
    "fuzzysort": "3.1.0",
    "gitlab-ai-provider": "6.19.0",
    "gray-matter": "4.0.3",
    "htmlparser2": "8.0.2",
    "http-proxy-agent": "7.0.2",
    "https-proxy-agent": "7.0.6",
    "immer": "11.1.4",
    "jose": "6.0.11",
    "jsonc-parser": "3.3.1",
    "mime-types": "3.0.2",
    "tree-sitter-bash": "0.25.0",
    "tree-sitter-powershell": "0.25.10",
    "web-tree-sitter": "0.25.10",
    "which": "6.0.1",
    "zod": "4.1.8"
  }
}
