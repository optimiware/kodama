{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@opencode/plugin",
  "version": "2.1.2",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "test": "bun test --only-failures",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json"
  },
  "exports": {
    ".": {
      "import": "./dist/promise/index.js",
      "types": "./dist/promise/index.d.ts"
    },
    "./effect": {
      "import": "./dist/effect/index.js",
      "types": "./dist/effect/index.d.ts"
    },
    "./host": {
      "import": "./dist/host.js",
      "types": "./dist/host.d.ts"
    },
    "./runtime": {
      "import": "./dist/runtime.js",
      "types": "./dist/runtime.d.ts"
    },
    "./tui": {
      "import": "./dist/tui/index.js",
      "types": "./dist/tui/index.d.ts"
    },
    "./*": {
      "import": "./dist/*.js",
      "types": "./dist/*.d.ts"
    }
  },
  "imports": {
    "#plugin-source": {
      "bun": "./dist/source.bun.js",
      "node": "./dist/source.node.js",
      "default": "./dist/source.node.js"
    }
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@ai-sdk/provider": "3.0.8",
    "@opencode/ai": "2.1.2",
    "@opencode/client": "2.1.2",
    "@opencode/protocol": "2.1.2",
    "@opencode/schema": "2.1.2",
    "@opencode/util": "2.1.2",
    "effect": "4.0.1"
  },
  "peerDependencies": {
    "@opencode/theme": "2.1.2",
    "@opentui/core": ">=0.6.6",
    "@opentui/solid": ">=0.6.6",
    "solid-js": ">=1.9.0"
  },
  "peerDependenciesMeta": {
    "@opencode/theme": {
      "optional": true
    },
    "@opentui/core": {
      "optional": true
    },
    "@opentui/solid": {
      "optional": true
    },
    "solid-js": {
      "optional": true
    }
  },
  "devDependencies": {
    "@opencode/theme": "2.1.2",
    "@opentui/core": "0.6.6",
    "@opentui/solid": "0.6.6",
    "@tsconfig/bun": "1.0.9",
    "@tsconfig/node22": "22.0.2",
    "@types/bun": "1.4.0",
    "@types/node": "24.12.2",
    "solid-js": "1.9.15",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "@typescript/native": "npm:typescript@7.0.2"
  }
}