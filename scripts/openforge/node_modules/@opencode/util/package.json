{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@opencode/util",
  "version": "2.1.2",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anomalyco/opencode.git",
    "directory": "packages/util"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "exports": {
    "./effect/layer-node": {
      "import": "./dist/effect/layer-node.js",
      "types": "./dist/effect/layer-node.d.ts"
    },
    "./*": {
      "import": "./dist/*.js",
      "types": "./dist/*.d.ts"
    }
  },
  "imports": {
    "#global-roots": {
      "workerd": "./dist/global-roots.workerd.js",
      "default": "./dist/global-roots.js"
    },
    "#runtime-import": {
      "workerd": "./dist/runtime/import.workerd.js",
      "bun": "./dist/runtime/import.bun.js",
      "node": "./dist/runtime/import.node.js",
      "default": "./dist/runtime/import.bun.js"
    }
  },
  "scripts": {
    "build": "bun run script/build.ts",
    "test": "bun test --only-failures",
    "typecheck": "tsc --noEmit",
    "typecheck:dist": "bun run build && bun typecheck --project tsconfig.dist.json"
  },
  "dependencies": {
    "@effect/opentelemetry": "4.0.1",
    "@effect/platform-node": "4.0.1",
    "@effect/platform-node-shared": "4.0.1",
    "@npmcli/arborist": "9.4.0",
    "@npmcli/config": "10.8.1",
    "@opentelemetry/api": "1.9.0",
    "@opentelemetry/api-logs": "0.219.0",
    "@opentelemetry/context-async-hooks": "2.8.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.219.0",
    "@opentelemetry/resources": "2.8.0",
    "@opentelemetry/sdk-logs": "0.219.0",
    "@opentelemetry/sdk-metrics": "2.8.0",
    "@opentelemetry/sdk-trace-base": "2.8.0",
    "@opentelemetry/sdk-trace-node": "2.8.0",
    "cross-spawn": "7.0.6",
    "effect": "4.0.1",
    "glob": "13.0.5",
    "mime-types": "3.0.2",
    "minimatch": "10.2.5",
    "npm-package-arg": "13.0.2",
    "open": "11.0.4",
    "pacote": "21.5.1"
  },
  "devDependencies": {
    "@tsconfig/bun": "1.0.9",
    "@types/bun": "1.4.0",
    "@types/cross-spawn": "6.0.6",
    "@types/node": "24.12.2",
    "@types/npm-package-arg": "6.1.4",
    "@types/npmcli__arborist": "6.3.3",
    "@types/pacote": "11.1.8",
    "@typescript/native": "npm:typescript@7.0.2"
  }
}
