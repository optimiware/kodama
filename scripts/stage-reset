#!/usr/bin/env bash
# Guarded pre-gate reset for the Kodama Scaleway stage only.
#
# The M2 gate is the ten non-Git scenarios after a clean stage reset (user
# decision U28). This driver records the pre-reset boundary, stops the
# controller, resets exactly the migration-owned database state, removes
# exactly the release-owned JetStream streams, deletes exactly the tenant
# namespace and the retained-log claim, and prints a non-secret summary.
#
# It never touches another stage resource: every target is a literal name in
# this file, the current context must be the stage context, and the release,
# Secrets and evidence directory must match before the first mutation.
#
# Run it later under the exclusive stage lock:
#   scripts/infra-slot.sh --exclusive scw-stage stack -- scripts/stage-reset
# A dry plan is available without the confirmation variable:
#   scripts/stage-reset --print-plan

set -euo pipefail
set +x
umask 077

readonly STAGE_CONTEXT='admin@kodama-stage-k8s'
readonly STAGE_NAMESPACE='kodama-system'
readonly TENANT_NAMESPACE='kodama-tenant-tenant-a'
readonly RELEASE='kodama-stage'
readonly CONFIRM='reset-kodama-stage'
readonly RETAINED_CLAIM='kodama-retained-logs'
readonly CONTROLLER_DEPLOYMENT='kodama'
readonly POD_TIMEOUT=300
readonly QUIESCE_TIMEOUT=180
readonly NAMESPACE_TIMEOUT=300
readonly CLAIM_TIMEOUT=180

# Digest-only images. The Node Vite image is pinned in
# deploy/stage/vite-acceptance.yaml; these two are the reset vehicles.
readonly POSTGRES_IMAGE='docker.io/library/postgres@sha256:3540c0362c809df084ffac0ae69fe794515f9de92692f02178bcdce0ef0302ac'
readonly NATS_IMAGE='docker.io/natsio/nats-box@sha256:9d5f35d286c3dcfca18bb2339b51345f9f89b580b237ab16ddfe609bdca9c72d'
readonly NATS_SERVER='tls://nats.kodama-system.svc.cluster.local:4222'

# The five roles the migration ledger creates: 0001 (owner and runtime) and
# 0009 (controller, publisher, auth), per
# internal/shell/app/migrate/migrate.go (bootstrap = 0001, 0009) and
# internal/shell/store/postgres/migrations.go. The setup administrator is not
# in this list and must survive.
readonly ROLES=(
  kodama_owner
  kodama_runtime
  kodama_controller
  kodama_publisher
  kodama_auth
)

# Exactly the release-owned streams; no other stream or the broker claim.
readonly STREAMS=(KODAMA_EVENTS KODAMA_INVALIDATIONS)

# Historical F-4 stuck cleanups recorded by the planner; the pre-state pod
# records presence/absence and a minimal state for each. They are never edited.
readonly HISTORICAL_EXECUTIONS=(
  execution-8311dba648540f467b85021261672330
  execution-c28bb6aebf9c0569089ced7fa57e24a6
  execution-e8dffd7e5304f28c943521d7c1adb06a
)

refuse() {
  printf 'refusing: %s\n' "$*" >&2
  exit 1
}

fail() {
  printf 'error: %s\n' "$*" >&2
  exit 1
}

usage() {
  cat <<'EOF'
Usage: scripts/stage-reset [--print-plan]

Guarded pre-gate reset for the Scaleway stage. Requires:
  KUBECONFIG                    readable regular file, mode 0600
  KODAMA_STAGE_CONTEXT          admin@kodama-stage-k8s
  KODAMA_STAGE_NAMESPACE        kodama-system
  KODAMA_STAGE_TENANT_NAMESPACE kodama-tenant-tenant-a
  KODAMA_STAGE_EVIDENCE_DIR     absolute private evidence directory
  KODAMA_STAGE_RESET_CONFIRM    reset-kodama-stage (apply mode only)
  KODAMA_STAGE_DATABASE_NAME    optional pinned application database name; it
                                must match the kodama-database Secret

--print-plan prints the intended actions and the exact SQL without any
mutation. Apply mode refuses without the confirmation variable.
EOF
}

mode='apply'
if [[ $# -gt 0 ]]; then
  case "$1" in
    --print-plan)
      [[ $# -eq 1 ]] || refuse '--print-plan takes no other arguments'
      mode='plan'
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      refuse "unknown argument '$1'"
      ;;
  esac
fi

require_cmd() {
  command -v "$1" >/dev/null 2>&1 || fail "required command '$1' is not on PATH"
}

stat_mode() {
  stat -c '%a' -- "$1"
}

# --- Static and read-only guards (before the first mutation) -----------------

[[ -n "${KUBECONFIG:-}" ]] || refuse 'KUBECONFIG is required'
[[ -f "$KUBECONFIG" && -r "$KUBECONFIG" ]] || refuse "KUBECONFIG '$KUBECONFIG' is not a readable regular file"
kubeconfig_mode="$(stat_mode "$KUBECONFIG")"
[[ "$kubeconfig_mode" == '600' ]] || refuse "KUBECONFIG '$KUBECONFIG' has mode $kubeconfig_mode; want 0600"

[[ "${KODAMA_STAGE_CONTEXT:-}" == "$STAGE_CONTEXT" ]] ||
  refuse "KODAMA_STAGE_CONTEXT must be exactly '$STAGE_CONTEXT'"
[[ "${KODAMA_STAGE_NAMESPACE:-}" == "$STAGE_NAMESPACE" ]] ||
  refuse "KODAMA_STAGE_NAMESPACE must be exactly '$STAGE_NAMESPACE'"
[[ "${KODAMA_STAGE_TENANT_NAMESPACE:-}" == "$TENANT_NAMESPACE" ]] ||
  refuse "KODAMA_STAGE_TENANT_NAMESPACE must be exactly '$TENANT_NAMESPACE'; prefixes and wildcards are refused"
case "${KODAMA_STAGE_NAMESPACE}${KODAMA_STAGE_TENANT_NAMESPACE}" in
  *'*'*|*'?'*) refuse 'namespace inputs must not contain wildcard characters' ;;
esac

[[ -n "${KODAMA_STAGE_EVIDENCE_DIR:-}" ]] || refuse 'KODAMA_STAGE_EVIDENCE_DIR is required'
[[ "${KODAMA_STAGE_EVIDENCE_DIR}" == /* ]] ||
  refuse "KODAMA_STAGE_EVIDENCE_DIR must be an absolute path, got '${KODAMA_STAGE_EVIDENCE_DIR}'"
[[ "$KODAMA_STAGE_EVIDENCE_DIR" != '/' ]] || refuse 'KODAMA_STAGE_EVIDENCE_DIR must not be the filesystem root'

# The application database is read from the kodama-database Secret inside the
# pods. An operator may pin the expected name explicitly; each pod refuses when
# it disagrees with the Secret, and a disconnected identifier is refused here.
stage_database_name="${KODAMA_STAGE_DATABASE_NAME:-}"
if [[ -n "$stage_database_name" ]]; then
  [[ "$stage_database_name" =~ ^[A-Za-z0-9_][A-Za-z0-9_-]{0,62}$ ]] ||
    refuse "KODAMA_STAGE_DATABASE_NAME '$stage_database_name' is not a bounded database identifier"
fi
database_name_env=''
if [[ -n "$stage_database_name" ]]; then
  database_name_env="        - {name: KODAMA_STAGE_DATABASE_NAME, value: '${stage_database_name}'}
"
fi

if [[ "$mode" == 'apply' ]]; then
  [[ "${KODAMA_STAGE_RESET_CONFIRM:-}" == "$CONFIRM" ]] ||
    refuse "set KODAMA_STAGE_RESET_CONFIRM=$CONFIRM to authorize the reset"
fi

require_cmd kubectl
require_cmd helm

kube() {
  kubectl --kubeconfig "$KUBECONFIG" --context "$STAGE_CONTEXT" "$@"
}

current_context="$(kubectl --kubeconfig "$KUBECONFIG" config current-context 2>/dev/null || true)"
[[ "$current_context" == "$STAGE_CONTEXT" ]] ||
  refuse "kubeconfig current context is '${current_context:-none}'; want '$STAGE_CONTEXT'"

helm --kubeconfig "$KUBECONFIG" --kube-context "$STAGE_CONTEXT" status "$RELEASE" \
  -n "$STAGE_NAMESPACE" >/dev/null 2>&1 ||
  refuse "Helm release '$RELEASE' is not present in '$STAGE_NAMESPACE'"

for secret in kodama-database-admin kodama-database kodama-broker kodama-nats-auth; do
  kube -n "$STAGE_NAMESPACE" get secret "$secret" >/dev/null 2>&1 ||
    refuse "Secret '$STAGE_NAMESPACE/$secret' is missing"
done

# --- Exact SQL ---------------------------------------------------------------

readonly RESET_SQL="$(cat <<'SQL'
-- One psql session against the stage application database as the setup
-- administrator. The database and administrator names never appear on a
-- command line: they are read from the session itself.
SELECT current_database() AS db, current_user AS admin \gset
SELECT EXISTS (SELECT 1 FROM pg_roles WHERE rolname = 'kodama_owner') AS has_owner \gset
\if :has_owner
-- 0001 grants kodama_owner to the administrator WITH INHERIT FALSE, SET TRUE.
-- The creator keeps ADMIN, so temporarily enabling INHERIT lets the
-- administrator exercise the database owner's privileges; it is narrowed back
-- below and the role is dropped. This needs no superuser and no wildcard.
GRANT kodama_owner TO :"admin" WITH INHERIT TRUE;
-- Reassign database ownership away from the owner role so the role can be
-- dropped. With INHERIT enabled the administrator passes the owner check.
ALTER DATABASE :"db" OWNER TO :"admin";
\endif
-- Reset exactly the two migration-owned schemas. public holds every
-- unqualified application table; kodama_meta holds the migration ledger.
DROP SCHEMA IF EXISTS public CASCADE;
DROP SCHEMA IF EXISTS kodama_meta CASCADE;
-- Recreate public owned by pg_database_owner, the pre-handover owner the
-- migrated schema expects: after 0001 hands the database to kodama_owner,
-- that role owns public and can create the 0003 tables.
CREATE SCHEMA public AUTHORIZATION pg_database_owner;
-- The setup administrator runs bootstrap migration 0009 after 0001 hands the
-- database to kodama_owner; 0009 grants USAGE on public to the system roles.
-- Keep the grant option public ownership gave it while it was the database
-- owner, scoped to the empty schema, so the non-superuser replay stays legal.
GRANT USAGE ON SCHEMA public TO :"admin" WITH GRANT OPTION;
\if :has_owner
-- Restore the original non-INHERIT membership before removing the role, so a
-- failure here never leaves the administrator with inherited owner rights.
GRANT kodama_owner TO :"admin" WITH INHERIT FALSE;
\endif
-- Drop exactly the five migration-created roles. Never a kodama_* wildcard
-- or a broad owned-object drop: the setup administrator must survive.
DROP ROLE IF EXISTS kodama_owner;
DROP ROLE IF EXISTS kodama_runtime;
DROP ROLE IF EXISTS kodama_controller;
DROP ROLE IF EXISTS kodama_publisher;
DROP ROLE IF EXISTS kodama_auth;
SQL
)"

readonly PRE_STATE_SQL="$(cat <<'SQL'
SELECT 'utc' AS key, to_char(now() AT TIME ZONE 'UTC', 'YYYY-MM-DD"T"HH24:MI:SS"Z"') AS value;
SELECT CASE WHEN to_regclass('kodama_meta.schema_migrations') IS NOT NULL THEN 'true' ELSE 'false' END AS has_ledger \gset
\if :has_ledger
SELECT 'ledger' AS key, coalesce(max(name), 'none') AS value FROM kodama_meta.schema_migrations;
\endif
SELECT CASE WHEN to_regclass('public.executions') IS NOT NULL
  AND EXISTS (SELECT 1 FROM pg_roles WHERE rolname = 'kodama_owner')
  THEN 'true' ELSE 'false' END AS can_read_executions \gset
\if :can_read_executions
-- The setup administrator owns neither the tables nor their privileges, and
-- every scoped table has FORCE RLS. Read as the migration owner (the
-- administrator holds SET) with the stage tenant pinned; an empty project
-- keeps the tenant-wide scope. tenant-a is the fixed suffix of
-- kodama-tenant-tenant-a, which the namespace guard above pins.
SET ROLE kodama_owner;
SET kodama.tenant_id = 'tenant-a';
SET kodama.project_id = '';
SELECT 'execution' AS key,
       e.id || '|state=' || e.state ||
       '|cleanup=' || coalesce(c.state, 'none') ||
       '|attempts=' || coalesce(c.attempts, 0)::text ||
       '|workspace=' || coalesce(e.workspace_id, 'none') AS value
FROM executions e
LEFT JOIN cleanup c ON c.execution_id = e.id
WHERE e.id IN (
  'execution-8311dba648540f467b85021261672330',
  'execution-c28bb6aebf9c0569089ced7fa57e24a6',
  'execution-e8dffd7e5304f28c943521d7c1adb06a'
)
ORDER BY e.id;
RESET ROLE;
RESET kodama.tenant_id;
RESET kodama.project_id;
\endif
SQL
)"

print_plan() {
  cat <<PLAN
stage pre-gate reset plan (no changes made)
  context:          $STAGE_CONTEXT
  namespace:        $STAGE_NAMESPACE
  tenant namespace: $TENANT_NAMESPACE
  retained claim:   $STAGE_NAMESPACE/pvc/$RETAINED_CLAIM
  release:          $RELEASE
  database:         from the kodama-database Secret's database_url (PGDATABASE)

actions, in order:
  1. record UTC start, Helm revision, replica counts, the three historical
     F-4 cleanups (${HISTORICAL_EXECUTIONS[*]}), and namespace/PVC/stream
     existence with read-only one-shot pods
  2. scale deployment/$CONTROLLER_DEPLOYMENT in $STAGE_NAMESPACE to 0 and wait
     for its pods to disappear (oauthsonas stays available)
  3. reset the application database in one one-shot pod ($POSTGRES_IMAGE):
$RESET_SQL
  4. delete exactly the JetStream streams and their consumers, in one
     one-shot pod ($NATS_IMAGE) over $NATS_SERVER:
       ${STREAMS[*]}
  5. delete exactly namespace $TENANT_NAMESPACE, wait, then delete exactly
     $STAGE_NAMESPACE/pvc/$RETAINED_CLAIM, wait
  6. write and print the UTC start/end, every target's result and the
     evidence paths

not performed by this script: scaling the deployment back up (the following
stage-deploy.sh Helm upgrade restores it) and any migration, bootstrap or
header/Secret write.
PLAN
}

if [[ "$mode" == 'plan' ]]; then
  print_plan
  exit 0
fi

# --- Apply mode --------------------------------------------------------------

EVIDENCE_DIR="${KODAMA_STAGE_EVIDENCE_DIR}"
mkdir -p -- "$EVIDENCE_DIR"
chmod 700 -- "$EVIDENCE_DIR"

readonly START_UTC="$(date -u +'%Y-%m-%dT%H:%M:%SZ')"
readonly BOUNDARY_FILE="$EVIDENCE_DIR/boundary.txt"
readonly PRE_STATE_FILE="$EVIDENCE_DIR/pre-state.log"
readonly SUMMARY_FILE="$EVIDENCE_DIR/summary.txt"
readonly WORKLOAD_STATE_FILE="$EVIDENCE_DIR/pre-state-workloads.txt"
readonly HELM_STATE_FILE="$EVIDENCE_DIR/pre-state-helm.txt"
readonly NAMESPACE_STATE_FILE="$EVIDENCE_DIR/pre-state-namespace.txt"
readonly CLAIM_STATE_FILE="$EVIDENCE_DIR/pre-state-claim.txt"
readonly STREAM_STATE_FILE="$EVIDENCE_DIR/pre-state-streams.txt"
readonly QUIESCE_FILE="$EVIDENCE_DIR/quiesce.log"
readonly DB_RESET_FILE="$EVIDENCE_DIR/database-reset.log"
readonly NATS_RESET_FILE="$EVIDENCE_DIR/nats-reset.log"
readonly NAMESPACE_RESET_FILE="$EVIDENCE_DIR/namespace-reset.log"
readonly CLAIM_RESET_FILE="$EVIDENCE_DIR/claim-reset.log"

printf 'reset_start_utc=%s\n' "$START_UTC" >"$BOUNDARY_FILE"
chmod 600 -- "$BOUNDARY_FILE"

pods=()

remove_pod_record() {
  local target="$1" kept=() candidate
  for candidate in "${pods[@]:-}"; do
    [[ -n "$candidate" && "$candidate" != "$target" ]] && kept+=("$candidate")
  done
  pods=("${kept[@]:-}")
}

delete_pods() {
  local pod
  for pod in "${pods[@]:-}"; do
    [[ -n "$pod" ]] || continue
    kube -n "$STAGE_NAMESPACE" delete "$pod" --wait=false >/dev/null 2>&1 || true
  done
  pods=()
}

cleanup() {
  delete_pods
}
trap cleanup EXIT
trap 'cleanup; exit 130' INT
trap 'cleanup; exit 143' TERM

# run_pod creates one one-shot pod from stdin manifest bytes, waits for a
# terminal phase, keeps its logs in a private file, and deletes it.
run_pod() {
  local log_file="$1" phase='' waited=0 pod=''
  pod="$(kube -n "$STAGE_NAMESPACE" create -o name -f -)" ||
    fail "could not create a one-shot pod (log: ${log_file})"
  [[ -n "$pod" ]] || fail 'kubectl create returned no pod name'
  pods+=("$pod")
  while :; do
    phase="$(kube -n "$STAGE_NAMESPACE" get "$pod" -o jsonpath='{.status.phase}' 2>/dev/null || true)"
    case "$phase" in
      Succeeded|Failed) break ;;
    esac
    if (( waited >= POD_TIMEOUT )); then
      break
    fi
    sleep 3
    waited=$((waited + 3))
  done
  kube -n "$STAGE_NAMESPACE" logs "$pod" >"$log_file" 2>&1 || true
  chmod 600 -- "$log_file" 2>/dev/null || true
  kube -n "$STAGE_NAMESPACE" delete "$pod" --wait=false >/dev/null 2>&1 || true
  remove_pod_record "$pod"
  [[ "$phase" == 'Succeeded' ]] ||
    fail "one-shot pod '$pod' did not succeed (phase: ${phase:-unknown}); log: $log_file"
}

record_if_present() {
  local output_file="$1"
  shift
  if "$@" >"$output_file" 2>&1; then
    return 0
  fi
  printf 'absent\n' >>"$output_file"
}

# The URLs are mounted only as environment values from the Secrets. The admin
# URL supplies the credentials and the application URL supplies the target
# database: the stage's admin URL points at the Scaleway admin database, whose
# owner the setup administrator cannot become. Both are split into libpq
# component variables inside the pod (never a psql argument) and the password
# is percent-decoded because bootstrap-secrets URL-encodes it.
pg_connect_script=': "${KODAMA_ADMIN_DATABASE_URL:?the admin Secret must provide KODAMA_ADMIN_DATABASE_URL}"
if [[ "$KODAMA_ADMIN_DATABASE_URL" =~ ^postgres(ql)?://([^:@/]+):([^@]*)@([^:/]+):([0-9]+)/([^?]+)(\?(.*))?$ ]]; then
  pg_user="${BASH_REMATCH[2]}"
  pg_password="${BASH_REMATCH[3]}"
  export PGHOST="${BASH_REMATCH[4]}"
  export PGPORT="${BASH_REMATCH[5]}"
  export PGUSER="$(printf "%b" "${pg_user//%/\\x}")"
  export PGPASSWORD="$(printf "%b" "${pg_password//%/\\x}")"
  pg_params="${BASH_REMATCH[8]:-}"
  if [[ "$pg_params" =~ (^|&)sslmode=([^&]+) ]]; then
    export PGSSLMODE="${BASH_REMATCH[2]}"
  fi
  export PGSSLROOTCERT=/etc/kodama/pg-ca/ca.crt
  unset pg_user pg_password pg_params KODAMA_ADMIN_DATABASE_URL
else
  echo "the administrator URL is not a supported PostgreSQL URI" >&2
  exit 1
fi
app_database=""
if [[ -n "${KODAMA_DATABASE_URL:-}" ]]; then
  if [[ "$KODAMA_DATABASE_URL" =~ ^postgres(ql)?://([^:@/]+):([^@]*)@([^:/]+):([0-9]+)/([^?]+)(\?(.*))?$ ]]; then
    app_database="${BASH_REMATCH[6]}"
  else
    echo "the application URL is not a supported PostgreSQL URI" >&2
    exit 1
  fi
fi
unset KODAMA_DATABASE_URL
if [[ -n "${KODAMA_STAGE_DATABASE_NAME:-}" ]]; then
  override_database="$KODAMA_STAGE_DATABASE_NAME"
  unset KODAMA_STAGE_DATABASE_NAME
  if [[ ! "$override_database" =~ ^[A-Za-z0-9_][A-Za-z0-9_-]{0,62}$ ]]; then
    echo "refusing: KODAMA_STAGE_DATABASE_NAME is not a bounded database identifier" >&2
    exit 1
  fi
  if [[ -n "$app_database" && "$override_database" != "$app_database" ]]; then
    echo "refusing: KODAMA_STAGE_DATABASE_NAME disagrees with the kodama-database Secret database_url" >&2
    exit 1
  fi
  app_database="$override_database"
fi
if [[ ! "$app_database" =~ ^[A-Za-z0-9_][A-Za-z0-9_-]{0,62}$ ]]; then
  echo "the application database name is not a bounded identifier" >&2
  exit 1
fi
export PGDATABASE="$app_database"
unset app_database override_database
'

# The application database must carry the migration ledger before any mutation:
# the empty admin database has none, and resetting it would silently do nothing
# while the ALTER DATABASE failed on its Scaleway-owned database.
readonly ledger_guard_script="$(cat <<'GUARD'
ledger_present="$(psql -X -q -A -t -v ON_ERROR_STOP=1 -c "SELECT CASE WHEN to_regclass('kodama_meta.schema_migrations') IS NOT NULL THEN 'present' ELSE 'absent' END")"
if [[ "$ledger_present" != "present" ]]; then
  printf "refusing: database %s has no kodama_meta.schema_migrations ledger\n" "$PGDATABASE" >&2
  exit 1
fi
unset ledger_present
GUARD
)"

pre_state_manifest="$(cat <<POD
apiVersion: v1
kind: Pod
metadata:
  generateName: kodama-stage-reset-preflight-
  labels:
    app.kubernetes.io/name: kodama
    app.kubernetes.io/component: stage-reset-preflight
spec:
  restartPolicy: Never
  automountServiceAccountToken: false
  securityContext:
    runAsNonRoot: true
    runAsUser: 65532
    seccompProfile: {type: RuntimeDefault}
  containers:
    - name: preflight
      image: "${POSTGRES_IMAGE}"
      command: ["bash", "-ec"]
      args:
        - |
$(printf '%s\n' "$pg_connect_script" | sed 's/^/          /')
          printf 'resolved_database=%s\n' "\$PGDATABASE"
$(printf '%s\n' "$ledger_guard_script" | sed 's/^/          /')
          psql -X -q -A -t -F '|' -v ON_ERROR_STOP=1 <<'SQL'
$(printf '%s\n' "$PRE_STATE_SQL" | sed 's/^/          /')
          SQL
      env:
        - {name: KODAMA_ADMIN_DATABASE_URL, valueFrom: {secretKeyRef: {name: kodama-database-admin, key: admin_url}}}
        - {name: KODAMA_DATABASE_URL, valueFrom: {secretKeyRef: {name: kodama-database, key: database_url}}}
${database_name_env}        - {name: PGAPPNAME, value: kodama-stage-reset-preflight}
      securityContext:
        allowPrivilegeEscalation: false
        readOnlyRootFilesystem: true
        capabilities: {drop: ["ALL"]}
      volumeMounts:
        - {name: database-ca, mountPath: /etc/kodama/pg-ca, readOnly: true}
      resources:
        requests: {cpu: 50m, memory: 64Mi}
        limits: {cpu: 500m, memory: 256Mi}
  volumes:
    - name: database-ca
      secret:
        secretName: kodama-database
        items: [{key: ca.crt, path: ca.crt}]
POD
)"

nats_common_script=': "${NATS_URL:?the pod must provide NATS_URL}"
nats_tls="--tlsca /etc/nats/tls/ca.crt --tlscert /etc/nats/tls/tls.crt --tlskey /etc/nats/tls/tls.key"
'

pre_state_nats_manifest="$(cat <<POD
apiVersion: v1
kind: Pod
metadata:
  generateName: kodama-stage-reset-stream-preflight-
  labels:
    app.kubernetes.io/name: kodama
    app.kubernetes.io/component: stage-reset-preflight
spec:
  restartPolicy: Never
  automountServiceAccountToken: false
  securityContext:
    runAsNonRoot: true
    runAsUser: 65532
    seccompProfile: {type: RuntimeDefault}
  containers:
    - name: streams
      image: "${NATS_IMAGE}"
      command: ["sh", "-ec"]
      # The nats CLI loads its JSON schemas from the working directory, so it
      # needs a writable cwd even though the image itself is read-only.
      workingDir: /tmp
      args:
        - |
$(printf '%s\n' "$nats_common_script" | sed 's/^/          /')
          for stream in KODAMA_EVENTS KODAMA_INVALIDATIONS; do
            printf 'stream=%s\n' "\$stream"
            if stream_output="\$(nats --server "\$NATS_URL" \$nats_tls stream info "\$stream" 2>&1)"; then
              printf '%s\n' "\$stream_output"
            else
              case "\$stream_output" in
                *"not found"*)
                  printf 'stream=%s absent\n' "\$stream"
                  ;;
                *)
                  printf '%s\n' "\$stream_output"
                  exit 1
                  ;;
              esac
            fi
          done
      env:
        - {name: NATS_URL, value: "${NATS_SERVER}"}
        - {name: NATS_USER, valueFrom: {secretKeyRef: {name: kodama-nats-auth, key: shell-user}}}
        - {name: NATS_PASSWORD, valueFrom: {secretKeyRef: {name: kodama-nats-auth, key: shell-password}}}
        - {name: HOME, value: /tmp}
      securityContext:
        allowPrivilegeEscalation: false
        readOnlyRootFilesystem: true
        capabilities: {drop: ["ALL"]}
      volumeMounts:
        - {name: broker-tls, mountPath: /etc/nats/tls, readOnly: true}
        - {name: tmp, mountPath: /tmp}
      resources:
        requests: {cpu: 25m, memory: 32Mi}
        limits: {cpu: 250m, memory: 128Mi}
  volumes:
    - name: broker-tls
      secret:
        secretName: kodama-broker
        items:
          - {key: ca.crt, path: ca.crt}
          - {key: tls.crt, path: tls.crt}
          - {key: tls.key, path: tls.key}
    - name: tmp
      emptyDir: {}
POD
)"

db_reset_manifest="$(cat <<POD
apiVersion: v1
kind: Pod
metadata:
  generateName: kodama-stage-reset-database-
  labels:
    app.kubernetes.io/name: kodama
    app.kubernetes.io/component: stage-reset-database
spec:
  restartPolicy: Never
  automountServiceAccountToken: false
  securityContext:
    runAsNonRoot: true
    runAsUser: 65532
    seccompProfile: {type: RuntimeDefault}
  containers:
    - name: reset
      image: "${POSTGRES_IMAGE}"
      command: ["bash", "-ec"]
      args:
        - |
$(printf '%s\n' "$pg_connect_script" | sed 's/^/          /')
$(printf '%s\n' "$ledger_guard_script" | sed 's/^/          /')
          psql -X -q -v ON_ERROR_STOP=1 <<'SQL'
$(printf '%s\n' "$RESET_SQL" | sed 's/^/          /')
          SQL
      env:
        - {name: KODAMA_ADMIN_DATABASE_URL, valueFrom: {secretKeyRef: {name: kodama-database-admin, key: admin_url}}}
        - {name: KODAMA_DATABASE_URL, valueFrom: {secretKeyRef: {name: kodama-database, key: database_url}}}
${database_name_env}        - {name: PGAPPNAME, value: kodama-stage-reset}
      securityContext:
        allowPrivilegeEscalation: false
        readOnlyRootFilesystem: true
        capabilities: {drop: ["ALL"]}
      volumeMounts:
        - {name: database-ca, mountPath: /etc/kodama/pg-ca, readOnly: true}
      resources:
        requests: {cpu: 50m, memory: 64Mi}
        limits: {cpu: 500m, memory: 256Mi}
  volumes:
    - name: database-ca
      secret:
        secretName: kodama-database
        items: [{key: ca.crt, path: ca.crt}]
POD
)"

nats_reset_manifest="$(cat <<POD
apiVersion: v1
kind: Pod
metadata:
  generateName: kodama-stage-reset-streams-
  labels:
    app.kubernetes.io/name: kodama
    app.kubernetes.io/component: stage-reset-streams
spec:
  restartPolicy: Never
  automountServiceAccountToken: false
  securityContext:
    runAsNonRoot: true
    runAsUser: 65532
    seccompProfile: {type: RuntimeDefault}
  containers:
    - name: streams
      image: "${NATS_IMAGE}"
      command: ["sh", "-ec"]
      # The nats CLI loads its JSON schemas from the working directory, so it
      # needs a writable cwd even though the image itself is read-only.
      workingDir: /tmp
      args:
        - |
$(printf '%s\n' "$nats_common_script" | sed 's/^/          /')
          for stream in KODAMA_EVENTS KODAMA_INVALIDATIONS; do
            if stream_output="\$(nats --server "\$NATS_URL" \$nats_tls stream info "\$stream" 2>&1)"; then
              consumers="\$(nats --server "\$NATS_URL" \$nats_tls consumer ls "\$stream" --names 2>/dev/null || true)"
              for consumer in \$consumers; do
                [ -n "\$consumer" ] || continue
                nats --server "\$NATS_URL" \$nats_tls consumer rm "\$stream" "\$consumer" -f
              done
              nats --server "\$NATS_URL" \$nats_tls stream rm "\$stream" -f
            else
              case "\$stream_output" in
                *"not found"*)
                  printf 'stream=%s absent\n' "\$stream"
                  ;;
                *)
                  printf '%s\n' "\$stream_output" >&2
                  exit 1
                  ;;
              esac
            fi
          done
      env:
        - {name: NATS_URL, value: "${NATS_SERVER}"}
        - {name: NATS_USER, valueFrom: {secretKeyRef: {name: kodama-nats-auth, key: shell-user}}}
        - {name: NATS_PASSWORD, valueFrom: {secretKeyRef: {name: kodama-nats-auth, key: shell-password}}}
        - {name: HOME, value: /tmp}
      securityContext:
        allowPrivilegeEscalation: false
        readOnlyRootFilesystem: true
        capabilities: {drop: ["ALL"]}
      volumeMounts:
        - {name: broker-tls, mountPath: /etc/nats/tls, readOnly: true}
        - {name: tmp, mountPath: /tmp}
      resources:
        requests: {cpu: 25m, memory: 32Mi}
        limits: {cpu: 250m, memory: 128Mi}
  volumes:
    - name: broker-tls
      secret:
        secretName: kodama-broker
        items:
          - {key: ca.crt, path: ca.crt}
          - {key: tls.crt, path: tls.crt}
          - {key: tls.key, path: tls.key}
    - name: tmp
      emptyDir: {}
POD
)"

# Step a: read-only pre-state. Every command below reads only.
kube -n "$STAGE_NAMESPACE" get deployments,statefulsets -o wide >"$WORKLOAD_STATE_FILE" 2>&1 ||
  printf 'absent\n' >>"$WORKLOAD_STATE_FILE"
record_if_present "$HELM_STATE_FILE" \
  helm --kubeconfig "$KUBECONFIG" --kube-context "$STAGE_CONTEXT" history "$RELEASE" -n "$STAGE_NAMESPACE" --max 1
record_if_present "$NAMESPACE_STATE_FILE" kube get namespace "$TENANT_NAMESPACE" -o name
record_if_present "$CLAIM_STATE_FILE" kube -n "$STAGE_NAMESPACE" get "pvc/$RETAINED_CLAIM" -o name

# Here-strings keep run_pod in this shell: on the right side of a pipe it would
# run in a subshell and its pods+= entry would be lost to the EXIT/TERM trap.
run_pod "$PRE_STATE_FILE" <<<"$pre_state_manifest"
run_pod "$STREAM_STATE_FILE" <<<"$pre_state_nats_manifest"

# Step b: quiesce the controller before any schema or stream change. Wait for
# the deployment's own pods to disappear (its selector), not merely for
# .status.replicas to report zero, because a terminating pod can still hold the
# API and database work this reset depends on.
kube -n "$STAGE_NAMESPACE" scale "deployment/$CONTROLLER_DEPLOYMENT" --replicas=0 >"$QUIESCE_FILE" 2>&1 ||
  fail "could not scale deployment/$CONTROLLER_DEPLOYMENT to 0 (log: $QUIESCE_FILE)"
selector="$(kube -n "$STAGE_NAMESPACE" get "deployment/$CONTROLLER_DEPLOYMENT" \
  -o go-template='{{range $key, $value := .spec.selector.matchLabels}}{{$key}}={{$value}},{{end}}' 2>/dev/null || true)"
selector="${selector%,}"
[[ -n "$selector" ]] ||
  fail "deployment/$CONTROLLER_DEPLOYMENT has no pod selector (log: $QUIESCE_FILE)"
waited=0
while :; do
  remaining="$(kube -n "$STAGE_NAMESPACE" get pods -l "$selector" --no-headers 2>/dev/null || true)"
  [[ -z "$remaining" ]] && break
  if (( waited >= QUIESCE_TIMEOUT )); then
    fail "$CONTROLLER_DEPLOYMENT still has pods in $STAGE_NAMESPACE after ${QUIESCE_TIMEOUT}s (selector: $selector)"
  fi
  sleep 3
  waited=$((waited + 3))
done
replicas="$(kube -n "$STAGE_NAMESPACE" get "deployment/$CONTROLLER_DEPLOYMENT" \
  -o jsonpath='{.status.replicas}' 2>/dev/null || true)"
printf 'scaled deployment/%s to 0 at %s (selector %s, replicas %s)\n' \
  "$CONTROLLER_DEPLOYMENT" "$(date -u +'%Y-%m-%dT%H:%M:%SZ')" "$selector" "${replicas:-0}" >>"$QUIESCE_FILE"

# Step c: one database reset pod.
run_pod "$DB_RESET_FILE" <<<"$db_reset_manifest"

# Step d: one JetStream reset pod.
run_pod "$NATS_RESET_FILE" <<<"$nats_reset_manifest"

# Step e: exactly the tenant namespace, then exactly the retained-log claim.
# An already-absent target is recorded as such so a retry after a partial
# failure completes without widening the target set.
if kube get namespace "$TENANT_NAMESPACE" -o name >/dev/null 2>&1; then
  kube delete namespace "$TENANT_NAMESPACE" --wait=true --timeout="${NAMESPACE_TIMEOUT}s" \
    >"$NAMESPACE_RESET_FILE" 2>&1 ||
    fail "could not delete namespace $TENANT_NAMESPACE (log: $NAMESPACE_RESET_FILE)"
else
  printf 'namespace=%s already absent\n' "$TENANT_NAMESPACE" >"$NAMESPACE_RESET_FILE"
fi
if kube -n "$STAGE_NAMESPACE" get "pvc/$RETAINED_CLAIM" -o name >/dev/null 2>&1; then
  kube -n "$STAGE_NAMESPACE" delete "pvc/$RETAINED_CLAIM" --wait=true --timeout="${CLAIM_TIMEOUT}s" \
    >"$CLAIM_RESET_FILE" 2>&1 ||
    fail "could not delete $STAGE_NAMESPACE/pvc/$RETAINED_CLAIM (log: $CLAIM_RESET_FILE)"
else
  printf 'retained_claim=%s/pvc/%s already absent\n' "$STAGE_NAMESPACE" "$RETAINED_CLAIM" >"$CLAIM_RESET_FILE"
fi

# Step f: the non-secret summary.
END_UTC="$(date -u +'%Y-%m-%dT%H:%M:%SZ')"
printf 'reset_end_utc=%s\n' "$END_UTC" >>"$BOUNDARY_FILE"
cat >"$SUMMARY_FILE" <<SUMMARY
kodama stage pre-gate reset complete
reset_start_utc=$START_UTC
reset_end_utc=$END_UTC
context=$STAGE_CONTEXT
release=$RELEASE
namespace=$STAGE_NAMESPACE
deployment=$CONTROLLER_DEPLOYMENT scaled to 0 (not scaled back)
database_schemas=public,kodama_meta reset
database_roles=${ROLES[*]} dropped
streams=${STREAMS[*]} deleted
tenant_namespace=$TENANT_NAMESPACE deleted
retained_claim=$STAGE_NAMESPACE/pvc/$RETAINED_CLAIM deleted
evidence_dir=$EVIDENCE_DIR
evidence:
  boundary=$BOUNDARY_FILE
  pre_state=$PRE_STATE_FILE
  workloads=$WORKLOAD_STATE_FILE
  helm=$HELM_STATE_FILE
  namespace=$NAMESPACE_STATE_FILE
  retained_claim=$CLAIM_STATE_FILE
  streams=$STREAM_STATE_FILE
  quiesce=$QUIESCE_FILE
  database_reset=$DB_RESET_FILE
  nats_reset=$NATS_RESET_FILE
  namespace_reset=$NAMESPACE_RESET_FILE
  claim_reset=$CLAIM_RESET_FILE
SUMMARY
chmod 600 -- "$SUMMARY_FILE"

cat "$SUMMARY_FILE"
