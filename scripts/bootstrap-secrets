#!/usr/bin/env bash
# Idempotently bootstrap Kubernetes Secrets, TLS certificates, and KMS-wrapped
# envelope key material for a named Kodama cluster (defaults to "stage").
#
# Secrets are created or reconciled inside the target Kubernetes cluster only
# (referenced via existingSecret by the Helm chart) and never committed to Git.

set -euo pipefail

# Bash's [[ =~ ]] resolves character classes with the process locale. Under a
# UTF-8 locale ([A-Za-z]) also matches accented and fullwidth letters, so a
# tenant, host, namespace or identifier could carry a non-ASCII byte into a
# manifest. Validate in the C locale so every class is ASCII-only.
LC_ALL=C
export LC_ALL

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=scripts/lib/deploy.sh
source "${SCRIPT_DIR}/lib/deploy.sh"
# shellcheck source=scripts/lib/scw.sh
source "${SCRIPT_DIR}/lib/scw.sh"
# shellcheck source=scripts/lib/gcp.sh
source "${SCRIPT_DIR}/lib/gcp.sh"
# shellcheck source=scripts/lib/aws.sh
source "${SCRIPT_DIR}/lib/aws.sh"

# Credential material must not survive a failed run. Every temporary path that
# can hold a database password or the KEK plaintext is registered here and
# removed on EXIT, INT and TERM, so a failing KMS call cannot leave key
# material in the persistent work directory.
KODAMA_BOOTSTRAP_TEMP_PATHS=()
register_bootstrap_temp_path() {
  KODAMA_BOOTSTRAP_TEMP_PATHS+=("$1")
}
cleanup_bootstrap_temp_paths() {
  local path
  # `${arr[@]+...}` keeps an empty array from tripping `set -u` on bash < 4.4.
  for path in ${KODAMA_BOOTSTRAP_TEMP_PATHS[@]+"${KODAMA_BOOTSTRAP_TEMP_PATHS[@]}"}; do
    rm -rf -- "$path"
  done
  KODAMA_BOOTSTRAP_TEMP_PATHS=()
}
trap cleanup_bootstrap_temp_paths EXIT
trap 'cleanup_bootstrap_temp_paths; exit 130' INT
trap 'cleanup_bootstrap_temp_paths; exit 143' TERM

# The broker authorization callout Secret. These names are a contract with
# deploy/charts/kodama-stack/values.yaml (nats.auth.callout.* and
# kodama.secrets.natsAuth.*): the chart sources both bypass users, the issuer
# public key and the account from here. test/component/deploy fails if the
# bootstrap key list, Secret name or account drifts from the chart.
KODAMA_NATS_AUTH_SECRET="kodama-nats-auth"
KODAMA_NATS_AUTH_ACCOUNT="KODAMA"
KODAMA_NATS_AUTH_KEYS=(
  issuer.seed
  issuer.pub
  shell-user
  shell-password
  callout-user
  callout-password
)

# The descriptor is produced from operator tfvars. Its values are interpolated
# into YAML manifests and env-files, so each one is validated before it can
# become cluster content: a quote, newline or extra "key=" in a tenant name,
# namespace, password or credential must be refused, not escaped later.
validate_namespace_name() {
  local namespace="${1:-}"
  if [[ ! "$namespace" =~ ^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$ ]]; then
    die "invalid Kubernetes namespace '${namespace}': lowercase alphanumeric characters or hyphens only"
  fi
}

validate_tenant_name() {
  local tenant="${1:-}"
  if [[ ! "$tenant" =~ ^[a-z0-9]([-a-z0-9]{0,47}[a-z0-9])?$ ]]; then
    die "invalid tenant name '${tenant}': 1-49 lowercase alphanumeric characters or hyphens only (so kodama-tenant-<id> stays within 63 characters)"
  fi
}

# require_descriptor_value refuses a field the descriptor does not carry: jq -r
# renders an absent or null field as the literal string "null", which would
# otherwise pass a permissive regex and reach a manifest, env-file or URL.
require_descriptor_value() {
  local label="$1"
  local value="${2:-}"
  if [[ -z "$value" || "$value" == "null" ]]; then
    die "descriptor is missing ${label}"
  fi
}

validate_postgres_identifier() {
  local label="$1"
  local identifier="${2:-}"
  if [[ -z "$identifier" || "$identifier" == "null" || ! "$identifier" =~ ^[A-Za-z_][A-Za-z0-9_.-]*$ ]]; then
    die "invalid ${label} '${identifier}'"
  fi
}

# validate_ipv6_literal checks the text inside a bracketed host. The DSN is
# "postgres://user:pw@[::1]:5432/db", so the brackets belong to the host and the
# inside must be an IPv6 literal: hex groups, at most one "::" compression and
# no punctuation that could move the URL boundary. A charset-only check accepts
# ":::"; the group rules reject it.
validate_ipv6_literal() {
  local inner="$1" head rest part groups=0 after
  [[ -n "$inner" ]] || return 1
  [[ "$inner" =~ ^[0-9A-Fa-f:.]+$ ]] || return 1
  [[ "$inner" != *:::* ]] || return 1
  # At most one "::".
  after="${inner#*::}"
  [[ "$after" != *::* ]] || return 1
  # The only dotted form is an IPv4 tail on an IPv6 literal
  # ("::ffff:10.0.0.1"); a bare "." or "1.2.3.4" is not a bracketed IPv6 host.
  if [[ "$inner" == *.* ]]; then
    [[ "$inner" =~ ^[0-9A-Fa-f:]+([0-9]{1,3}\.){3}[0-9]{1,3}$ ]] || return 1
    return 0
  fi
  if [[ "$inner" == *::* ]]; then
    head="${inner%%::*}"
    rest="${inner#*::}"
    # No stray single colon touching the "::" compression.
    [[ "$head" != *: ]] || return 1
    [[ "$rest" != :* ]] || return 1
  else
    head="$inner"
    rest=""
  fi
  for part in ${head//:/ }; do
    [[ "${#part}" -le 4 ]] || return 1
    groups=$((groups + 1))
  done
  for part in ${rest//:/ }; do
    [[ "${#part}" -le 4 ]] || return 1
    groups=$((groups + 1))
  done
  if [[ "$inner" == *::* ]]; then
    [[ "$groups" -le 7 ]] || return 1
  else
    [[ "$groups" -eq 8 ]] || return 1
  fi
}

# validate_host accepts an IPv4 literal or a DNS name, and an IPv6 literal only
# in bracketed form ("[::1]"). A bare IPv6 literal is refused: interpolated
# next to the DSN's ':' port separator it changes how the URL parses.
#
# The DNS-name branch mirrors the production validator in
# internal/installation/url_validation.go (validHostName): at most 253 bytes,
# dot-separated labels of at most 63 bytes, no leading or trailing dot and no
# empty label (a double dot), and no label that starts or ends with a hyphen.
# A charset-only regex would accept "db.example.", "db..example" and
# "db-.example"; the DSN and the provider's TLS peer name treat those
# differently from the name an operator believes they configured.
validate_host() {
  local host="${1:-}"
  require_descriptor_value "postgres.host" "$host"
  if [[ "$host" == \[*\] ]]; then
    local inner="${host:1:${#host}-2}"
    if ! validate_ipv6_literal "$inner"; then
      die "invalid postgres.host '${host}'"
    fi
    return 0
  fi
  if [[ "$host" == *:* ]]; then
    die "invalid postgres.host '${host}': an IPv6 literal must be bracketed, e.g. [::1]"
  fi
  if [[ "${#host}" -gt 253 || "$host" == .* || "$host" == *. ]]; then
    die "invalid postgres.host '${host}'"
  fi
  local label
  local IFS=.
  for label in $host; do
    if [[ -z "$label" || "${#label}" -gt 63 || "$label" == -* || "$label" == *- ]]; then
      die "invalid postgres.host '${host}'"
    fi
  done
  if [[ ! "$host" =~ ^[A-Za-z0-9._-]+$ ]]; then
    die "invalid postgres.host '${host}'"
  fi
}

# validate_postgres_ssl_mode accepts exactly verify-full. Every production
# PostgreSQL connection requires verified TLS; verify-ca (and every weaker
# mode) is refused here instead of reaching the server as a configuration it
# will reject.
validate_postgres_ssl_mode() {
  case "${1:-}" in
    verify-full) ;;
    "") die "invalid postgres.ssl_mode '': only verify-full is accepted" ;;
    *) die "invalid postgres.ssl_mode '$1': only verify-full is accepted (production refuses a weaker TLS mode)" ;;
  esac
}

# validate_url_safe_password enforces the production password grammar
# [A-Za-z0-9._~-]. The password becomes the userinfo component of a PostgreSQL
# DSN; the production composition refuses a value that would need
# percent-encoding, so a password outside this set must fail before any Secret
# is written rather than be encoded into a URL the server will reject.
validate_url_safe_password() {
  local label="$1"
  local value="${2:-}"
  if [[ -z "$value" ]]; then
    die "${label} is empty; refusing an empty database password"
  fi
  if [[ ! "$value" =~ ^[A-Za-z0-9._~-]+$ ]]; then
    die "${label} contains a character outside the URL-safe set [A-Za-z0-9._~-]; the production composition refuses a password that needs percent-encoding"
  fi
}

# validate_env_value refuses values that would terminate or add an env-file
# line. Credentials and coordinates are interpolated into key=value files that
# kubectl reads verbatim; a newline there is an injection, not a long value.
validate_env_value() {
  local label="$1"
  local value="${2:-}"
  if [[ "$value" == *$'\n'* || "$value" == *$'\r'* ]]; then
    die "${label} contains a newline; refusing to write an env-file"
  fi
}

# url_encode percent-encodes one URL component. Passwords are generated hex,
# but an operator override may contain any byte; without encoding a '@' changes
# the userinfo boundary and a newline adds an env-file key.
#
# The value reaches jq on stdin, never through `--arg`: an argument would be
# readable by any local user through /proc/<pid>/cmdline and `ps`. `-sR` keeps
# embedded newlines in one string and `@uri` encodes them as %0A; `-r` plus the
# command substitution strip jq's own line terminator, so the result is exactly
# the percent-encoding of the input.
url_encode() {
  printf '%s' "$1" | jq -sRr '@uri'
}

usage() {
  cat <<'EOF'
Usage:
  scripts/bootstrap-secrets <scw|gcp|aws> [options]

Options:
  --cluster <name>       Logical cluster name (default: $KODAMA_CLUSTER or "stage")
  --descriptor <path>    Explicit deployment_descriptor JSON file path
  --kubeconfig <path>    Explicit kubeconfig file path
  --rotate-pki           Regenerate and overwrite in-cluster TLS certificates
  --rotate-nats-auth     Regenerate the broker callout issuer key and bypass passwords
  --dry-run              Generate local PKI and verify descriptor without contacting Kubernetes or KMS
  -h, --help             Show this help message
EOF
}

generate_cluster_pki() {
  local pki_dir="$1"
  local release_ns="$2"
  local rotate="${3:-false}"

  require_cmd openssl

  if [[ "$rotate" != "true" && -f "${pki_dir}/ca.crt" && -f "${pki_dir}/kodama.crt" && -f "${pki_dir}/nats.crt" && -f "${pki_dir}/client.crt" ]]; then
    log_info "reusing existing cluster PKI in ${pki_dir}"
    return 0
  fi

  log_info "generating internal TLS CA, server, and client certificates in ${pki_dir}"
  (
    umask 077
    openssl req -x509 -newkey rsa:4096 -sha256 -days 3650 -nodes \
      -keyout "${pki_dir}/ca.key" \
      -out "${pki_dir}/ca.crt" \
      -subj "/CN=kodama-internal-ca" >/dev/null 2>&1

    cat >"${pki_dir}/kodama-ext.cnf" <<EOF
subjectAltName = DNS:kodama,DNS:kodama.${release_ns},DNS:kodama.${release_ns}.svc,DNS:kodama.${release_ns}.svc.cluster.local,IP:127.0.0.1
extendedKeyUsage = serverAuth,clientAuth
EOF

    openssl req -newkey rsa:2048 -nodes \
      -keyout "${pki_dir}/kodama.key" \
      -out "${pki_dir}/kodama.csr" \
      -subj "/CN=kodama.${release_ns}.svc.cluster.local" >/dev/null 2>&1

    openssl x509 -req -in "${pki_dir}/kodama.csr" \
      -CA "${pki_dir}/ca.crt" -CAkey "${pki_dir}/ca.key" -CAcreateserial \
      -out "${pki_dir}/kodama.crt" -days 825 -sha256 \
      -extfile "${pki_dir}/kodama-ext.cnf" >/dev/null 2>&1

    cat >"${pki_dir}/nats-ext.cnf" <<EOF
subjectAltName = DNS:nats,DNS:nats.${release_ns},DNS:nats.${release_ns}.svc,DNS:nats.${release_ns}.svc.cluster.local,IP:127.0.0.1
extendedKeyUsage = serverAuth,clientAuth
EOF

    openssl req -newkey rsa:2048 -nodes \
      -keyout "${pki_dir}/nats.key" \
      -out "${pki_dir}/nats.csr" \
      -subj "/CN=nats.${release_ns}.svc.cluster.local" >/dev/null 2>&1

    openssl x509 -req -in "${pki_dir}/nats.csr" \
      -CA "${pki_dir}/ca.crt" -CAkey "${pki_dir}/ca.key" -CAcreateserial \
      -out "${pki_dir}/nats.crt" -days 825 -sha256 \
      -extfile "${pki_dir}/nats-ext.cnf" >/dev/null 2>&1

    cat >"${pki_dir}/client-ext.cnf" <<EOF
extendedKeyUsage = clientAuth
EOF

    openssl req -newkey rsa:2048 -nodes \
      -keyout "${pki_dir}/client.key" \
      -out "${pki_dir}/client.csr" \
      -subj "/CN=kodama-broker-client" >/dev/null 2>&1

    openssl x509 -req -in "${pki_dir}/client.csr" \
      -CA "${pki_dir}/ca.crt" -CAkey "${pki_dir}/ca.key" -CAcreateserial \
      -out "${pki_dir}/client.crt" -days 825 -sha256 \
      -extfile "${pki_dir}/client-ext.cnf" >/dev/null 2>&1
  )
}

# oauthsonas_leaf_matches_ca <pki_dir>: the stored OAuthSonas leaf was signed
# by the installation CA currently on disk. --rotate-pki replaces ca.crt, so a
# leaf issued for the previous CA must be re-issued even on a run that does not
# rotate itself (rotate while OAuthSonas is disabled, then enable it later):
# otherwise the cluster serves a certificate that no peer trusting the current
# CA can verify. A missing or unreadable leaf is treated as stale.
oauthsonas_leaf_matches_ca() {
  local pki_dir="$1"
  [[ -f "${pki_dir}/oauthsonas.crt" && -f "${pki_dir}/oauthsonas.key" && -f "${pki_dir}/ca.crt" ]] || return 1
  openssl verify -CAfile "${pki_dir}/ca.crt" "${pki_dir}/oauthsonas.crt" >/dev/null 2>&1
}

# ensure_oauthsonas_cert <pki_dir> <release_ns> <reissue>: issue the OAuthSonas
# server certificate from the existing installation CA, once. It never touches
# the CA. With reissue=true it re-issues the leaf, so an installation-CA
# rotation or a leaf signed by a replaced CA does not survive in the cluster.
ensure_oauthsonas_cert() {
  local pki_dir="$1"
  local release_ns="$2"
  local reissue="${3:-false}"
  [[ -f "${pki_dir}/ca.crt" && -f "${pki_dir}/ca.key" ]] || die "no installation CA in ${pki_dir}"
  if [[ "$reissue" != "true" && -f "${pki_dir}/oauthsonas.crt" && -f "${pki_dir}/oauthsonas.key" ]]; then
    return 0
  fi
  log_info "issuing the OAuthSonas certificate from the installation CA"
  (
    umask 077
    cat >"${pki_dir}/oauthsonas-ext.cnf" <<OAUTHSONAS_EXT
subjectAltName = DNS:oauthsonas,DNS:oauthsonas.${release_ns},DNS:oauthsonas.${release_ns}.svc,DNS:oauthsonas.${release_ns}.svc.cluster.local,IP:127.0.0.1
extendedKeyUsage = serverAuth
OAUTHSONAS_EXT
    openssl req -newkey rsa:2048 -nodes \
      -keyout "${pki_dir}/oauthsonas.key" \
      -out "${pki_dir}/oauthsonas.csr" \
      -subj "/CN=oauthsonas.${release_ns}.svc.cluster.local" >/dev/null 2>&1
    openssl x509 -req -in "${pki_dir}/oauthsonas.csr" \
      -CA "${pki_dir}/ca.crt" -CAkey "${pki_dir}/ca.key" -CAcreateserial \
      -out "${pki_dir}/oauthsonas.crt" -days 825 -sha256 \
      -extfile "${pki_dir}/oauthsonas-ext.cnf" >/dev/null 2>&1
  )
}

# git_leaf_matches_ca <pki_dir> <tenant>: the stored Git leaf for <tenant> was
# signed by the installation CA currently on disk.
git_leaf_matches_ca() {
  local pki_dir="$1"
  local tenant="$2"
  [[ -f "${pki_dir}/git-${tenant}.crt" && -f "${pki_dir}/git-${tenant}.key" && -f "${pki_dir}/ca.crt" ]] || return 1
  openssl verify -CAfile "${pki_dir}/ca.crt" "${pki_dir}/git-${tenant}.crt" >/dev/null 2>&1
}

# ensure_git_cert <pki_dir> <tenant> <release_ns> <reissue>: issue the per-tenant
# Git server certificate from the existing installation CA, covering the
# in-cluster Service DNS names and 127.0.0.1 for local port-forward access.
ensure_git_cert() {
  local pki_dir="$1"
  local tenant="$2"
  local release_ns="$3"
  local reissue="${4:-false}"
  [[ -f "${pki_dir}/ca.crt" && -f "${pki_dir}/ca.key" ]] || die "no installation CA in ${pki_dir}"
  if [[ "$reissue" != "true" && -f "${pki_dir}/git-${tenant}.crt" && -f "${pki_dir}/git-${tenant}.key" ]]; then
    return 0
  fi
  log_info "issuing the Git service certificate for tenant ${tenant} from the installation CA"
  (
    umask 077
    cat >"${pki_dir}/git-${tenant}-ext.cnf" <<GIT_EXT
subjectAltName = DNS:kodama-git-${tenant},DNS:kodama-git-${tenant}.${release_ns},DNS:kodama-git-${tenant}.${release_ns}.svc,DNS:kodama-git-${tenant}.${release_ns}.svc.cluster.local,IP:127.0.0.1
extendedKeyUsage = serverAuth
GIT_EXT
    openssl req -newkey rsa:2048 -nodes \
      -keyout "${pki_dir}/git-${tenant}.key" \
      -out "${pki_dir}/git-${tenant}.csr" \
      -subj "/CN=kodama-git-${tenant}.${release_ns}.svc.cluster.local" >/dev/null 2>&1
    openssl x509 -req -in "${pki_dir}/git-${tenant}.csr" \
      -CA "${pki_dir}/ca.crt" -CAkey "${pki_dir}/ca.key" -CAcreateserial \
      -out "${pki_dir}/git-${tenant}.crt" -days 825 -sha256 \
      -extfile "${pki_dir}/git-${tenant}-ext.cnf" >/dev/null 2>&1
  )
}

reconcile_helm_owned_tenant_namespace() {
  local kubeconfig_file="$1"
  local tenant="$2"
  local release_name="$3"
  local release_ns="$4"
  local tenant_ns="kodama-tenant-${tenant}"

  kubectl --kubeconfig="$kubeconfig_file" apply -f - >/dev/null <<EOF
apiVersion: v1
kind: Namespace
metadata:
  name: ${tenant_ns}
  labels:
    app.kubernetes.io/name: kodama
    app.kubernetes.io/managed-by: Helm
    kodama.dev/tenant: "${tenant}"
    pod-security.kubernetes.io/enforce: baseline
    pod-security.kubernetes.io/warn: restricted
    pod-security.kubernetes.io/audit: restricted
  annotations:
    meta.helm.sh/release-name: "${release_name}"
    meta.helm.sh/release-namespace: "${release_ns}"
EOF
}

# create_secret_mixed <namespace> <name> <env-file> [key=file ...]
# kubectl refuses --from-env-file together with --from-file, so the Secret is
# rendered client-side from both sources and created in one atomic request.
create_secret_mixed() {
  local namespace="$1" name="$2" env_file="$3"
  shift 3
  local manifest data_json='{}' kv key file b64
  manifest="$("${kcmd[@]}" -n "$namespace" create secret generic "$name" \
    --from-env-file="$env_file" --dry-run=client -o json)" || return 1
  for kv in "$@"; do
    key="${kv%%=*}"
    file="${kv#*=}"
    # File content and accumulated Secret data reach jq on stdin. `--arg v`
    # would put the base64 bytes on the jq process argv; the helper is generic,
    # so no caller's file content may depend on the file being non-secret.
    # `base64` without `-w0` works on GNU and BSD, where the flag differs.
    b64="$(base64 <"$file" | tr -d '\n')" || return 1
    data_json="$({ printf '%s\n' "$data_json"; printf '%s\n' "$b64"; } |
      jq -c -nR --arg k "$key" 'input as $acc | input as $v | ($acc | fromjson) + {($k): $v}')" || return 1
  done
  # Both JSON documents (the dry-run Secret and the merged file keys) reach jq
  # on stdin; the merged Secret is piped to kubectl, never placed on argv.
  { printf '%s\n' "$manifest"; printf '%s\n' "$data_json"; } |
    jq -s '.[0].data += .[1] | .[0]' |
    "${kcmd[@]}" -n "$namespace" create -f - >/dev/null
}

# generate_nats_auth_issuer_pair writes one account NKey seed/public pair to
# the given files. Generation is delegated to tools/nats-auth-key, which uses
# the same account-prefix framing as the Shell callout codec. The tool writes
# files only; no key material is printed or passed on argv.
generate_nats_auth_issuer_pair() {
  local seed_file="$1"
  local public_file="$2"
  if [[ -n "${KODAMA_NATS_AUTH_KEY_TOOL:-}" ]]; then
    "${KODAMA_NATS_AUTH_KEY_TOOL}" -seed-file "$seed_file" -public-file "$public_file" ||
      die "could not generate the NATS callout issuer key pair"
    return 0
  fi
  require_cmd go
  ( cd "${KODAMA_REPO_ROOT}" && go run ./tools/nats-auth-key -seed-file "$seed_file" -public-file "$public_file" ) ||
    die "could not generate the NATS callout issuer key pair"
}

# bootstrap_nats_auth_secret creates or reconciles kodama-nats-auth:
#
#   * issuer.seed / issuer.pub: one account NKey pair. The broker receives only
#     the public half; the Shell signs callout grants with the seed.
#   * shell-user / shell-password, callout-user / callout-password: the two
#     bypass users the broker lists in auth_users.
#   * account: the callout account name, equal to nats.auth.callout.account.
#
# A rerun reuses every existing value and fills only missing keys. All values
# are regenerated only with --rotate-nats-auth. Secret material travels through
# 0600 files in a 0700 temporary directory and reaches kubectl through
# --from-file; it is never an argument or a log line.
bootstrap_nats_auth_secret() {
  local namespace="$1"
  local rotate="$2"
  local parent_dir="$3"
  local secret_name="$KODAMA_NATS_AUTH_SECRET"
  local account="$KODAMA_NATS_AUTH_ACCOUNT"
  local auth_dir existing_json key file
  local exists="false" changed="false" existing_account=""
  local -a material_keys=("${KODAMA_NATS_AUTH_KEYS[@]}")

  auth_dir="$(mktemp -d "${parent_dir}/nats-auth.XXXXXX")"
  chmod 700 "$auth_dir"
  register_bootstrap_temp_path "$auth_dir"
  existing_json="${auth_dir}/existing.json"

  # A probe failure is not the same as absence. kubectl exits non-zero for an
  # unreachable API server, an expired credential and a missing object alike;
  # only the explicit NotFound message means the Secret does not exist. Any
  # other error must stop the run: treating it as absence would generate a new
  # issuer and new bypass passwords and apply them over a Secret that still
  # exists in the cluster.
  local probe_output="" probe_status=0
  probe_output="$("${kcmd[@]}" -n "$namespace" get secret "$secret_name" 2>&1)" || probe_status=$?
  if [[ "$probe_status" -eq 0 ]]; then
    exists="true"
  elif [[ "$probe_output" != *"(NotFound)"* ]]; then
    die "could not determine whether Secret ${namespace}/${secret_name} exists: ${probe_output}"
  fi

  # Read the existing Secret once, into a private file. A failed read is fatal:
  # silently regenerating over a Secret that exists but cannot be read would
  # rotate the issuer and every bypass password on a plain rerun.
  if [[ "$exists" == "true" && "$rotate" != "true" ]]; then
    "${kcmd[@]}" -n "$namespace" get secret "$secret_name" -o json >"$existing_json" ||
      die "could not read existing Secret ${namespace}/${secret_name}"
    chmod 600 "$existing_json"
    existing_account="$(jq -r '.data.account // empty | @base64d' "$existing_json" 2>/dev/null || true)"
  fi

  for key in "${material_keys[@]}"; do
    file="${auth_dir}/${key}"
    : >"$file"
    chmod 600 "$file"
    if [[ -f "$existing_json" ]]; then
      # jq receives the Secret JSON on stdin and writes one decoded value to a
      # file; no value is an argument or a process's stdout.
      jq -j --arg key "$key" '.data[$key] // empty | @base64d' "$existing_json" >"$file" ||
        die "could not decode ${key} from Secret ${namespace}/${secret_name}"
    fi
    if [[ ! -s "$file" ]]; then
      changed="true"
    fi
  done

  # The seed and public half are one pair: if either is missing, regenerate the
  # pair together so the broker and Shell can never disagree. A complete pair
  # is always preserved unless --rotate-nats-auth was requested.
  if [[ ! -s "${auth_dir}/issuer.seed" || ! -s "${auth_dir}/issuer.pub" ]]; then
    generate_nats_auth_issuer_pair "${auth_dir}/issuer.seed" "${auth_dir}/issuer.pub"
    chmod 600 "${auth_dir}/issuer.seed" "${auth_dir}/issuer.pub"
  fi

  if [[ ! -s "${auth_dir}/shell-user" ]]; then
    printf '%s' 'shell' >"${auth_dir}/shell-user"
  fi
  if [[ ! -s "${auth_dir}/shell-password" ]]; then
    local shell_password
    shell_password="$(openssl rand -hex 32)"
    printf '%s' "$shell_password" >"${auth_dir}/shell-password"
  fi
  if [[ ! -s "${auth_dir}/callout-user" ]]; then
    printf '%s' 'callout' >"${auth_dir}/callout-user"
  fi
  if [[ ! -s "${auth_dir}/callout-password" ]]; then
    local callout_password
    callout_password="$(openssl rand -hex 32)"
    printf '%s' "$callout_password" >"${auth_dir}/callout-password"
  fi
  printf '%s' "$account" >"${auth_dir}/account"
  chmod 600 "${auth_dir}/account"

  local apply="false"
  if [[ "$exists" != "true" || "$rotate" == "true" || "$changed" == "true" ]]; then
    apply="true"
  elif [[ "$existing_account" != "$account" ]]; then
    # The account is not secret, but the broker and callout must agree on it.
    # Reapply the preserved material with the chart's current value.
    apply="true"
  fi

  if [[ "$apply" == "true" ]]; then
    local -a from_files=()
    for key in "${material_keys[@]}" account; do
      from_files+=("--from-file=${key}=${auth_dir}/${key}")
    done
    "${kcmd[@]}" -n "$namespace" create secret generic "$secret_name" "${from_files[@]}" \
      --dry-run=client -o yaml | "${kcmd[@]}" apply -f - >/dev/null
    if [[ "$rotate" == "true" ]]; then
      log_info "rotated Secret ${namespace}/${secret_name}"
    elif [[ "$exists" == "true" ]]; then
      log_info "updated Secret ${namespace}/${secret_name} (existing values preserved)"
    else
      log_info "created Secret ${namespace}/${secret_name}"
    fi
  else
    log_info "preserving existing Secret ${namespace}/${secret_name} (pass --rotate-nats-auth to rotate)"
  fi
}

main() {
  if [[ $# -eq 0 ]]; then
    usage >&2
    exit 2
  fi

  case "${1:-}" in
    -h|--help|help)
      usage
      exit 0
      ;;
  esac

  local cloud="$1"
  shift
  validate_cloud "$cloud"

  local cluster="${KODAMA_CLUSTER:-stage}"
  local descriptor_file=""
  local kubeconfig_file=""
  local rotate_pki="false"
  local rotate_nats_auth="false"
  local dry_run="false"

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --cluster)
        [[ $# -ge 2 ]] || die "--cluster requires a cluster name"
        cluster="$2"
        shift 2
        ;;
      --descriptor)
        [[ $# -ge 2 ]] || die "--descriptor requires a file path"
        descriptor_file="$2"
        shift 2
        ;;
      --kubeconfig)
        [[ $# -ge 2 ]] || die "--kubeconfig requires a file path"
        kubeconfig_file="$2"
        shift 2
        ;;
      --rotate-pki)
        rotate_pki="true"
        shift
        ;;
      --rotate-nats-auth)
        rotate_nats_auth="true"
        shift
        ;;
      --dry-run)
        dry_run="true"
        shift
        ;;
      -h|--help)
        usage
        exit 0
        ;;
      *)
        die "unknown option: $1"
        ;;
    esac
  done

  validate_cluster_name "$cluster"

  local work_dir iac_dir tf_data_dir
  work_dir="$(ensure_cluster_work_dir "$cloud" "$cluster")"
  iac_dir="$(cloud_iac_dir "$cloud")"
  tf_data_dir="${work_dir}/tfdata"
  if [[ -z "$descriptor_file" ]]; then
    descriptor_file="${work_dir}/descriptor.json"
  fi
  if [[ -z "$kubeconfig_file" ]]; then
    kubeconfig_file="${work_dir}/kubeconfig.yaml"
  fi

  verify_descriptor_identity "$descriptor_file" "$cloud" "$cluster"

  local release_ns release_name pg_host pg_port pg_db kms_key_id kms_key_ref kms_key_adapter region postgres_ssl_mode
  local project_id admin_user admin_db
  release_ns="$(jq -r '.release_namespace' "$descriptor_file")"
  release_name="kodama-${cluster}"
  pg_host="$(jq -r '.postgres.host' "$descriptor_file")"
  pg_port="$(jq -r '.postgres.port' "$descriptor_file")"
  pg_db="$(jq -r '.postgres.database_name' "$descriptor_file")"
  kms_key_id="$(jq -r '.kms.key_id' "$descriptor_file")"
  kms_key_ref="$(jq -r '.kms.key_ref' "$descriptor_file")"
  kms_key_adapter="$(jq -r '.kms.key_adapter // empty' "$descriptor_file")"
  region="$(jq -r '.region' "$descriptor_file")"
  postgres_ssl_mode="$(jq -r '.postgres.ssl_mode // "verify-full"' "$descriptor_file")"
  project_id=""
  if [[ "$cloud" == "scw" ]]; then
    project_id="$(jq -r '.account_or_project_id' "$descriptor_file")"
  fi
  # Admin identifiers are read here, not after the kubectl calls, so an
  # invalid admin URL can never be the reason a cluster object was created.
  # They are only used when the administrator password is available.
  admin_user=""
  admin_db=""
  if [[ -n "${TF_VAR_postgres_admin_password:-}" ]]; then
    admin_user="$(jq -r '.postgres.admin_user // empty' "$descriptor_file")"
    admin_db="$(jq -r '.postgres.admin_database // .postgres.database_name // empty' "$descriptor_file")"
  fi

  # Everything below is interpolated into YAML or env-files. Validate the
  # descriptor-controlled values before the first kubectl call so an injectable
  # descriptor cannot create or modify cluster objects.
  require_descriptor_value "release_namespace" "$release_ns"
  require_descriptor_value "postgres.port" "$pg_port"
  require_descriptor_value "postgres.database_name" "$pg_db"
  require_descriptor_value "kms.key_id" "$kms_key_id"
  require_descriptor_value "kms.key_ref" "$kms_key_ref"
  require_descriptor_value "kms.key_adapter" "$kms_key_adapter"
  require_descriptor_value "region" "$region"
  # The descriptor is produced by OpenTofu, but this script decides which cloud
  # KMS client to call. A descriptor whose key adapter or reference family names
  # another provider must fail here, before the first kubectl call, rather than
  # create cluster Secrets and then send a foreign key id to the selected
  # provider (or the selected cloud's key id to the wrong API).
  local expected_key_adapter
  expected_key_adapter="$(key_adapter_for_cloud "$cloud")"
  validate_env_value "kms.key_adapter" "$kms_key_adapter"
  if [[ "$kms_key_adapter" != "$expected_key_adapter" ]]; then
    die "descriptor kms.key_adapter '${kms_key_adapter}' does not match the selected cloud '${cloud}' (expected '${expected_key_adapter}')"
  fi
  if [[ "$kms_key_ref" != "${expected_key_adapter}:"* ]]; then
    die "descriptor kms.key_ref does not belong to the ${expected_key_adapter} key reference family"
  fi
  validate_namespace_name "$release_ns"
  validate_host "$pg_host"
  validate_postgres_identifier "postgres.database_name" "$pg_db"
  # A port is a TCP port: no sign, no leading zero and inside 1..65535. The
  # regex alone would accept 0, 65536 and 99999; the arithmetic bounds the
  # value before it becomes the DSN's port separator.
  if [[ ! "$pg_port" =~ ^[1-9][0-9]{0,4}$ ]] || (( pg_port < 1 || pg_port > 65535 )); then
    die "invalid postgres.port '${pg_port}'"
  fi
  validate_postgres_ssl_mode "$postgres_ssl_mode"
  validate_env_value "postgres.host" "$pg_host"
  validate_env_value "region" "$region"
  # Operator-supplied database passwords are validated here, before the first
  # kubectl call, so a refused password cannot leave a half-created Secret set.
  if [[ -n "${KODAMA_DB_RUNTIME_PASSWORD:-}" ]]; then
    validate_url_safe_password "KODAMA_DB_RUNTIME_PASSWORD" "$KODAMA_DB_RUNTIME_PASSWORD"
  fi
  if [[ -n "${KODAMA_DB_CONTROLLER_PASSWORD:-}" ]]; then
    validate_url_safe_password "KODAMA_DB_CONTROLLER_PASSWORD" "$KODAMA_DB_CONTROLLER_PASSWORD"
  fi
  if [[ -n "${KODAMA_DB_PUBLISHER_PASSWORD:-}" ]]; then
    validate_url_safe_password "KODAMA_DB_PUBLISHER_PASSWORD" "$KODAMA_DB_PUBLISHER_PASSWORD"
  fi
  if [[ -n "${KODAMA_DB_AUTH_PASSWORD:-}" ]]; then
    validate_url_safe_password "KODAMA_DB_AUTH_PASSWORD" "$KODAMA_DB_AUTH_PASSWORD"
  fi
  if [[ -n "${TF_VAR_postgres_admin_password:-}" ]]; then
    validate_url_safe_password "TF_VAR_postgres_admin_password" "$TF_VAR_postgres_admin_password"
    [[ -n "$admin_user" ]] || die "descriptor has no postgres.admin_user"
    [[ -n "$admin_db" ]] || die "descriptor has no postgres.admin_database or postgres.database_name"
  fi
  if [[ -n "$admin_user" ]]; then
    validate_postgres_identifier "postgres.admin_user" "$admin_user"
  fi
  if [[ -n "$admin_db" ]]; then
    validate_postgres_identifier "postgres.admin_database" "$admin_db"
  fi
  if [[ "$cloud" == "scw" ]]; then
    require_descriptor_value "account_or_project_id" "$project_id"
    validate_env_value "account_or_project_id" "$project_id"
  fi
  local descriptor_tenant
  while IFS= read -r descriptor_tenant; do
    validate_tenant_name "$descriptor_tenant"
  done < <(jq -r '.tenants[]' "$descriptor_file")

  generate_cluster_pki "${work_dir}/pki" "$release_ns" "$rotate_pki"

  if [[ "$dry_run" == "true" ]]; then
    log_info "dry-run complete for ${cloud}/${cluster}: verified descriptor identity and generated PKI under ${work_dir}/pki"
    return 0
  fi

  require_cmd kubectl openssl base64 jq
  [[ -f "$kubeconfig_file" ]] || die "kubeconfig not found at ${kubeconfig_file} (run 'scripts/deploy ${cloud} kubeconfig --cluster ${cluster}' first)"

  # The KMS IAM credentials are read and validated before the first kubectl
  # call: either value is interpolated into the credentials Secret's env-file,
  # so a newline must fail the run before any cluster object is touched. The
  # values stay in shell variables and reach jq on stdin.
  local kms_creds_json="" scw_app_access="" scw_app_secret=""
  if [[ "$cloud" == "scw" ]]; then
    kms_creds_json="$(scw_read_kms_credentials_json "$iac_dir" "$tf_data_dir")"
    scw_app_access="$(printf '%s' "$kms_creds_json" | jq -r '.access_key // empty')"
    scw_app_secret="$(printf '%s' "$kms_creds_json" | jq -r '.secret_key // empty')"
    [[ -n "$scw_app_access" && -n "$scw_app_secret" ]] ||
      die "OpenTofu output kms_credentials has no access_key/secret_key; refusing to leave kodama-kms-credentials stale"
    validate_env_value "KMS access_key" "$scw_app_access"
    validate_env_value "KMS secret_key" "$scw_app_secret"
  fi

  local kcmd=(kubectl "--kubeconfig=${kubeconfig_file}")

  # Ensure release namespace exists
  "${kcmd[@]}" create namespace "$release_ns" --dry-run=client -o yaml | "${kcmd[@]}" apply -f - >/dev/null

  # Preserve existing in-cluster PKI secrets unless --rotate-pki is requested.
  # The three Secrets are reconciled independently because the stack chart
  # always requires the broker's client CA (kodama-broker-tls) and the control
  # plane always requires its client certificate (kodama-broker); an upgrade
  # where only kodama-tls exists must still create the other two.
  if [[ "$rotate_pki" == "true" ]] || ! "${kcmd[@]}" -n "$release_ns" get secret kodama-tls >/dev/null 2>&1; then
    "${kcmd[@]}" -n "$release_ns" create secret generic kodama-tls \
      --from-file=tls.crt="${work_dir}/pki/kodama.crt" \
      --from-file=tls.key="${work_dir}/pki/kodama.key" \
      --from-file=ca.crt="${work_dir}/pki/ca.crt" \
      --dry-run=client -o yaml | "${kcmd[@]}" apply -f - >/dev/null
  else
    log_info "preserving existing Secret ${release_ns}/kodama-tls (pass --rotate-pki to rotate)"
  fi

  if [[ "$rotate_pki" == "true" ]] || ! "${kcmd[@]}" -n "$release_ns" get secret kodama-broker-tls >/dev/null 2>&1; then
    "${kcmd[@]}" -n "$release_ns" create secret generic kodama-broker-tls \
      --from-file=tls.crt="${work_dir}/pki/nats.crt" \
      --from-file=tls.key="${work_dir}/pki/nats.key" \
      --from-file=ca.crt="${work_dir}/pki/ca.crt" \
      --dry-run=client -o yaml | "${kcmd[@]}" apply -f - >/dev/null
  else
    log_info "preserving existing Secret ${release_ns}/kodama-broker-tls (pass --rotate-pki to rotate)"
  fi

  if [[ "$rotate_pki" == "true" ]] || ! "${kcmd[@]}" -n "$release_ns" get secret kodama-broker >/dev/null 2>&1; then
    "${kcmd[@]}" -n "$release_ns" create secret generic kodama-broker \
      --from-literal=nats_url="tls://nats.${release_ns}.svc.cluster.local:4222" \
      --from-file=ca.crt="${work_dir}/pki/ca.crt" \
      --from-file=tls.crt="${work_dir}/pki/client.crt" \
      --from-file=tls.key="${work_dir}/pki/client.key" \
      --dry-run=client -o yaml | "${kcmd[@]}" apply -f - >/dev/null
  else
    log_info "preserving existing Secret ${release_ns}/kodama-broker (pass --rotate-pki to rotate)"
  fi

  # The broker authorization callout Secret is a stage prerequisite: the chart
  # defaults to nats.auth.mode=callout and refuses to render without it. It is
  # reconciled independently of the PKI secrets above; --rotate-pki never
  # rotates the issuer or the bypass passwords, and --rotate-nats-auth never
  # touches the TLS material.
  bootstrap_nats_auth_secret "$release_ns" "$rotate_nats_auth" "$work_dir"

  local tenant tenant_ns
  while IFS= read -r tenant; do
    tenant_ns="kodama-tenant-${tenant}"
    reconcile_helm_owned_tenant_namespace "$kubeconfig_file" "$tenant" "$release_name" "$release_ns"

    if [[ "$rotate_pki" == "true" ]] || ! "${kcmd[@]}" -n "$tenant_ns" get secret kodama-workload-ca >/dev/null 2>&1; then
      "${kcmd[@]}" -n "$tenant_ns" create secret generic kodama-workload-ca \
        --from-file=ca.crt="${work_dir}/pki/ca.crt" \
        --dry-run=client -o yaml | "${kcmd[@]}" apply -f - >/dev/null
    fi

    if [[ -n "${KODAMA_WITH_GIT_TLS:-}" ]]; then
      local git_reissue="false"
      if [[ "$rotate_pki" == "true" ]]; then
        git_reissue="true"
      elif ! git_leaf_matches_ca "${work_dir}/pki" "$tenant"; then
        git_reissue="true"
      fi
      ensure_git_cert "${work_dir}/pki" "$tenant" "$release_ns" "$git_reissue"
      if [[ "$git_reissue" == "true" ]] || ! "${kcmd[@]}" -n "$release_ns" get secret "kodama-git-${tenant}-tls" >/dev/null 2>&1; then
        "${kcmd[@]}" -n "$release_ns" create secret tls "kodama-git-${tenant}-tls" \
          --cert="${work_dir}/pki/git-${tenant}.crt" --key="${work_dir}/pki/git-${tenant}.key" \
          --dry-run=client -o yaml | "${kcmd[@]}" apply -f - >/dev/null
        log_info "applied Secret ${release_ns}/kodama-git-${tenant}-tls"
      else
        log_info "preserving existing Secret ${release_ns}/kodama-git-${tenant}-tls (pass --rotate-pki to rotate)"
      fi
    fi
  done < <(jq -r '.tenants[]' "$descriptor_file")

  # Reconcile database connection URLs via a 0600 env-file (never passing passwords on argv)
  if ! "${kcmd[@]}" -n "$release_ns" get secret kodama-database >/dev/null 2>&1; then
    local db_env_file db_ca_file
    db_env_file="$(mktemp "${work_dir}/db-env.XXXXXX")"
    db_ca_file="$(mktemp "${work_dir}/db-ca.XXXXXX")"
    register_bootstrap_temp_path "$db_env_file"
    register_bootstrap_temp_path "$db_ca_file"
    # The env-file holds four passwords and must stay private. The provider CA
    # certificate is public material mounted into the client pods, so it is
    # world-readable; the containing work directory is still 0700.
    chmod 600 "$db_env_file"
    chmod 644 "$db_ca_file"

    # Declaration and assignment are separate: inside `${VAR:-$(...)}` a
    # failing `openssl rand` is swallowed and the script would build a DSN with
    # an empty password. A plain assignment propagates the failure under
    # `set -e`. The generated value reaches the env-file by redirect, never argv.
    local runtime_pw controller_pw publisher_pw auth_pw
    runtime_pw="${KODAMA_DB_RUNTIME_PASSWORD:-}"
    controller_pw="${KODAMA_DB_CONTROLLER_PASSWORD:-}"
    publisher_pw="${KODAMA_DB_PUBLISHER_PASSWORD:-}"
    auth_pw="${KODAMA_DB_AUTH_PASSWORD:-}"
    [[ -n "$runtime_pw" ]] || runtime_pw="$(openssl rand -hex 24)"
    [[ -n "$controller_pw" ]] || controller_pw="$(openssl rand -hex 24)"
    [[ -n "$publisher_pw" ]] || publisher_pw="$(openssl rand -hex 24)"
    [[ -n "$auth_pw" ]] || auth_pw="$(openssl rand -hex 24)"
    local runtime_pw_enc controller_pw_enc publisher_pw_enc auth_pw_enc
    runtime_pw_enc="$(url_encode "$runtime_pw")"
    controller_pw_enc="$(url_encode "$controller_pw")"
    publisher_pw_enc="$(url_encode "$publisher_pw")"
    auth_pw_enc="$(url_encode "$auth_pw")"
    local ssl_params="sslmode=${postgres_ssl_mode}&sslrootcert=/etc/kodama/pg-ca/ca.crt"

    cat >"$db_env_file" <<EOF
database_url=postgres://kodama_runtime:${runtime_pw_enc}@${pg_host}:${pg_port}/${pg_db}?${ssl_params}
controller_url=postgres://kodama_controller:${controller_pw_enc}@${pg_host}:${pg_port}/${pg_db}?${ssl_params}
publisher_url=postgres://kodama_publisher:${publisher_pw_enc}@${pg_host}:${pg_port}/${pg_db}?${ssl_params}
auth_url=postgres://kodama_auth:${auth_pw_enc}@${pg_host}:${pg_port}/${pg_db}?${ssl_params}
EOF

    # The database certificate is signed by the provider, not by the internal
    # CA, so a missing output is an error rather than a reason to trust the
    # wrong root.
    command -v tofu >/dev/null 2>&1 || die "tofu is required to read database_ca_certificate"
    TF_DATA_DIR="$tf_data_dir" tofu -chdir="$iac_dir" output -raw database_ca_certificate >"$db_ca_file" 2>/dev/null && [[ -s "$db_ca_file" ]] ||
      die "OpenTofu output database_ca_certificate is unavailable; run this after a successful apply"

    create_secret_mixed "$release_ns" kodama-database "$db_env_file" ca.crt="$db_ca_file"

    log_info "created Secret ${release_ns}/kodama-database"
  else
    log_info "preserving existing Secret ${release_ns}/kodama-database"
  fi

  # Development identity provider (opt in with KODAMA_WITH_OAUTHSONAS=1): its
  # TLS certificate from the installation CA, and a shared access code that gates
  # the persona picker, created once. Like the other PKI Secrets, oauthsonas-tls
  # is reconciled only when it is missing, when --rotate-pki is requested, or
  # when the stored leaf no longer verifies against the CA on disk; a rerun that
  # keeps the same CA must not touch the in-cluster certificate.
  if [[ -n "${KODAMA_WITH_OAUTHSONAS:-}" ]]; then
    # Decide before ensure_oauthsonas_cert writes a new leaf: --rotate-pki is
    # unconditional and must not depend on inspecting the old leaf, while a
    # leaf signed by a replaced installation CA is stale even on a plain run.
    local oauthsonas_reissue="false"
    if [[ "$rotate_pki" == "true" ]]; then
      oauthsonas_reissue="true"
    elif ! oauthsonas_leaf_matches_ca "${work_dir}/pki"; then
      oauthsonas_reissue="true"
    fi
    ensure_oauthsonas_cert "${work_dir}/pki" "$release_ns" "$oauthsonas_reissue"
    if [[ "$oauthsonas_reissue" == "true" ]] || ! "${kcmd[@]}" -n "$release_ns" get secret oauthsonas-tls >/dev/null 2>&1; then
      "${kcmd[@]}" -n "$release_ns" create secret tls oauthsonas-tls \
        --cert="${work_dir}/pki/oauthsonas.crt" --key="${work_dir}/pki/oauthsonas.key" \
        --dry-run=client -o yaml | "${kcmd[@]}" apply -f - >/dev/null
      log_info "applied Secret ${release_ns}/oauthsonas-tls"
    else
      log_info "preserving existing Secret ${release_ns}/oauthsonas-tls (pass --rotate-pki to rotate)"
    fi
    if ! "${kcmd[@]}" -n "$release_ns" get secret oauthsonas-access >/dev/null 2>&1; then
      local access_code_file
      access_code_file="$(mktemp "${work_dir}/oauth-access.XXXXXX")"
      chmod 600 "$access_code_file"
      register_bootstrap_temp_path "$access_code_file"
      openssl rand -hex 16 >"$access_code_file"
      "${kcmd[@]}" -n "$release_ns" create secret generic oauthsonas-access \
        --from-file=access_code="$access_code_file" >/dev/null
      rm -f "$access_code_file"
      log_info "created Secret ${release_ns}/oauthsonas-access"
    fi
  fi

  # The database administrator URL is read only by the migration Job. It is
  # derived from the password the infrastructure was applied with, so it is
  # created only when that password is available in the environment.
  if [[ -n "${TF_VAR_postgres_admin_password:-}" ]]; then
    # admin_user/admin_db were read and validated before the first kubectl
    # call; this block only writes and applies the env-file.
    local admin_pw_enc admin_env_file
    admin_pw_enc="$(url_encode "$TF_VAR_postgres_admin_password")"
    admin_env_file="$(mktemp "${work_dir}/admin-env.XXXXXX")"
    chmod 600 "$admin_env_file"
    register_bootstrap_temp_path "$admin_env_file"
    printf 'admin_url=postgres://%s:%s@%s:%s/%s?sslmode=%s&sslrootcert=/etc/kodama/pg-ca/ca.crt\n' \
      "$admin_user" "$admin_pw_enc" "$pg_host" "$pg_port" "$admin_db" "$postgres_ssl_mode" >"$admin_env_file"
    "${kcmd[@]}" -n "$release_ns" create secret generic kodama-database-admin \
      --from-env-file="$admin_env_file" --dry-run=client -o yaml | "${kcmd[@]}" apply -f - >/dev/null
    rm -f "$admin_env_file"
    log_info "applied Secret ${release_ns}/kodama-database-admin"
  else
    log_info "TF_VAR_postgres_admin_password not set; leaving kodama-database-admin as is"
  fi

  # Reconcile the KMS-wrapped 32-byte KEK blob (version 1). The keys Secret is
  # created once and never regenerated: a new KEK would make every value
  # encrypted under the old one unreadable. Deleting it by hand is a data-loss
  # decision, not a rotation procedure.
  if ! "${kcmd[@]}" -n "$release_ns" get secret kodama-keys >/dev/null 2>&1; then
    local kek_dir tmp_plain tmp_cipher wrapped_b64
    kek_dir="$(mktemp -d "${work_dir}/kek.XXXXXX")"
    chmod 700 "$kek_dir"
    register_bootstrap_temp_path "$kek_dir"
    tmp_plain="${kek_dir}/plaintext"
    tmp_cipher="${kek_dir}/ciphertext"
    (
      umask 077
      : >"$tmp_plain"
      : >"$tmp_cipher"
    )
    chmod 600 "$tmp_plain" "$tmp_cipher"

    openssl rand 32 >"$tmp_plain"
    case "$cloud" in
      scw)
        local plain_b64
        plain_b64="$(base64 <"$tmp_plain" | tr -d '\n')"
        wrapped_b64="$(scw_kms_encrypt_blob "$kms_key_id" "$region" "$plain_b64")"
        ;;
      gcp)
        wrapped_b64="$(gcp_kms_encrypt_blob "$kms_key_id" "$tmp_plain" "$tmp_cipher")"
        ;;
      aws)
        wrapped_b64="$(aws_kms_encrypt_blob "$kms_key_id" "$region" "$tmp_plain")"
        ;;
    esac

    printf '%s' "$wrapped_b64" | base64 --decode >"$tmp_cipher"
    "${kcmd[@]}" -n "$release_ns" create secret generic kodama-keys \
      --from-file=kek-v1.blob="$tmp_cipher" >/dev/null

    log_info "created Secret ${release_ns}/kodama-keys with KMS-wrapped KEK v1 (${kms_key_ref})"
  else
    log_info "preserving existing Secret ${release_ns}/kodama-keys"
  fi

  # Scaleway authenticates the KMS client with an IAM API key. It lives in its
  # own Secret, reapplied on every run, so rotating it (taint the key in
  # OpenTofu, then rerun) never touches the KEK above.
  if [[ "$cloud" == "scw" ]]; then
    # The credentials were read and validated before the first kubectl call.
    local creds_env_file
    validate_env_value "region" "$region"
    creds_env_file="$(mktemp "${work_dir}/creds-env.XXXXXX")"
    chmod 600 "$creds_env_file"
    register_bootstrap_temp_path "$creds_env_file"
    cat >"$creds_env_file" <<CREDS_END
SCW_ACCESS_KEY=${scw_app_access}
SCW_SECRET_KEY=${scw_app_secret}
SCW_DEFAULT_PROJECT_ID=${project_id}
SCW_DEFAULT_REGION=${region}
CREDS_END
    "${kcmd[@]}" -n "$release_ns" create secret generic kodama-kms-credentials \
      --from-env-file="$creds_env_file" --dry-run=client -o yaml | "${kcmd[@]}" apply -f - >/dev/null
    rm -f "$creds_env_file"
    log_info "applied Secret ${release_ns}/kodama-kms-credentials"
  fi

  log_info "bootstrap-secrets complete for ${cloud}/${cluster}"
}

main "$@"
