#!/usr/bin/env bash
# Bootstrap or reconcile the per-cloud OpenTofu remote state storage bucket.
#
# One versioned bucket per (cloud, account/project, region) holds independent,
# natively locked state objects for multiple clusters (e.g. stage, preview):
#   scw: s3://<bucket>/kodama/scw/<project_id>/<region>/<cluster>/infrastructure.tfstate
#   gcp: gs://<bucket>/kodama/gcp/<project_id>/<region>/<cluster>/default.tfstate
#   aws: s3://<bucket>/kodama/aws/<account_id>/<region>/<cluster>/infrastructure.tfstate

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=scripts/lib/deploy.sh
source "${SCRIPT_DIR}/lib/deploy.sh"
# shellcheck source=scripts/lib/scw.sh
source "${SCRIPT_DIR}/lib/scw.sh"
# shellcheck source=scripts/lib/gcp.sh
source "${SCRIPT_DIR}/lib/gcp.sh"
# shellcheck source=scripts/lib/aws.sh
source "${SCRIPT_DIR}/lib/aws.sh"

usage() {
  cat <<'EOF'
Usage:
  scripts/bootstrap-state <scw|gcp|aws> [options]

Options:
  --project, --account <id>  Cloud project ID (scw, gcp) or account ID (aws)
  --region <region>          Cloud region (default: fr-par / europe-west1 / eu-west-1)
  --bucket <name>            Explicit state bucket name
  --auto-approve             Apply OpenTofu changes without interactive prompt
  --dry-run                  Validate and write state-backend.env without applying cloud changes
  -h, --help                 Show this help message
EOF
}

main() {
  if [[ $# -eq 0 ]]; then
    usage >&2
    exit 2
  fi

  case "${1:-}" in
    -h|--help|help)
      usage
      exit 0
      ;;
  esac

  local cloud="$1"
  shift
  validate_cloud "$cloud"

  local project_or_account=""
  local region=""
  local bucket_name="${KODAMA_STATE_BUCKET:-}"
  local auto_approve="false"
  local dry_run="false"

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --project|--account)
        [[ $# -ge 2 ]] || die "$1 requires a value"
        project_or_account="$2"
        shift 2
        ;;
      --region)
        [[ $# -ge 2 ]] || die "--region requires a value"
        region="$2"
        shift 2
        ;;
      --bucket)
        [[ $# -ge 2 ]] || die "--bucket requires a value"
        bucket_name="$2"
        shift 2
        ;;
      --auto-approve)
        auto_approve="true"
        shift
        ;;
      --dry-run)
        dry_run="true"
        shift
        ;;
      -h|--help)
        usage
        exit 0
        ;;
      *)
        die "unknown option: $1"
        ;;
    esac
  done

  if [[ -z "$region" ]]; then
    region="$(default_region_for_cloud "$cloud")"
  fi

  if [[ -z "$project_or_account" ]]; then
    case "$cloud" in
      scw) project_or_account="$(scw_resolve_project_id)" ;;
      gcp) project_or_account="$(gcp_resolve_project_id)" ;;
      aws) project_or_account="$(aws_resolve_account_id)" ;;
    esac
  fi

  validate_cloud "$cloud"
  validate_state_region "$region"
  validate_state_project_or_account "$project_or_account"

  if [[ -z "$bucket_name" ]]; then
    local short_id="${project_or_account//[^a-zA-Z0-9]/}"
    short_id="$(printf '%s' "$short_id" | tr '[:upper:]' '[:lower:]' | cut -c1-16)"
    bucket_name="kodama-tofu-state-${cloud}-${short_id}-${region}"
  fi
  validate_state_bucket "$bucket_name"

  local work_dir bootstrap_dir safe_id bootstrap_state_dir tf_data_dir scoped_env_file default_env_file
  work_dir="$(cloud_work_dir "$cloud")"
  bootstrap_dir="$(cloud_bootstrap_dir "$cloud")"
  safe_id="${project_or_account//[^a-zA-Z0-9_-]/_}"
  bootstrap_state_dir="${work_dir}/bootstrap/${safe_id}-${region}"
  tf_data_dir="${bootstrap_state_dir}/tfdata"
  scoped_env_file="${work_dir}/state-backend-${safe_id}-${region}.env"
  default_env_file="${work_dir}/state-backend.env"

  (
    umask 077
    mkdir -p "$tf_data_dir"
    cat >"$scoped_env_file" <<EOF
# Generated by scripts/bootstrap-state for ${cloud} (${project_or_account} / ${region})
KODAMA_STATE_CLOUD="${cloud}"
KODAMA_STATE_BUCKET="${bucket_name}"
KODAMA_STATE_REGION="${region}"
KODAMA_STATE_PROJECT_OR_ACCOUNT="${project_or_account}"
EOF
    chmod 0600 "$scoped_env_file"
    cp -f "$scoped_env_file" "$default_env_file"
    chmod 0600 "$default_env_file"
  )

  log_info "configured state backend metadata at ${scoped_env_file}"
  log_info "cloud=${cloud} region=${region} bucket=${bucket_name}"

  if [[ "$dry_run" == "true" ]]; then
    log_info "dry-run enabled: skipping tofu apply in ${bootstrap_dir}"
    return 0
  fi

  require_cmd tofu

  local id_var="project_id"
  if [[ "$cloud" == "aws" ]]; then
    id_var="account_id"
  fi

  TF_DATA_DIR="$tf_data_dir" tofu -chdir="$bootstrap_dir" init -input=false

  local apply_args=(
    "-input=false"
    "-state=${bootstrap_state_dir}/terraform.tfstate"
    "-var=${id_var}=${project_or_account}"
    "-var=region=${region}"
    "-var=bucket_name=${bucket_name}"
  )
  if [[ "$auto_approve" == "true" ]]; then
    apply_args+=("-auto-approve")
  fi

  TF_DATA_DIR="$tf_data_dir" tofu -chdir="$bootstrap_dir" apply "${apply_args[@]}"
  log_info "remote state bucket '${bucket_name}' is ready for multi-cluster deployments on ${cloud}"
}

main "$@"
