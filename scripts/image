#!/usr/bin/env bash
# scripts/image: build the Kodama image and push it, printing the pushed digest.
#
#   scripts/image build-push --repository <registry/path/name> [--tag <tag>]
#                            [--version <version>] [--platforms <os/arch,...>]
#                            [--also-tag <tag>]
#   scripts/image build      --repository <registry/path/name> [--tag <tag>]
#                            [--version <version>] [--platforms <os/arch,...>]
#                            [--also-tag <tag>]
#
# `build` only builds and prints the local reference <repository>:<tag>.
#
# The binary is stamped with the version (default: the VERSION file) and the
# full git revision of this checkout; `kodama version` prints both.
#
# When multiple comma-separated --platforms are given (for example
# linux/amd64,linux/arm64), scripts/image builds an OCI manifest index with
# `podman manifest create` + `podman build --platform ... --manifest ...` and
# pushes all architectures with `podman manifest push --all --digestfile`.
# When --platforms is omitted, single-arch `podman build` keeps local CI fast.
#
# The digest comes from `podman push --digestfile` (or `podman manifest push
# --digestfile`), i.e. what the registry accepted, not the local image ID.
# Registry credentials come from an existing `podman login`; this script never
# reads or prints one. Output of build-push: <repository>@sha256:<digest>.
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

usage() {
  cat <<'USAGE'
Usage: scripts/image build-push --repository <registry/path/name> [--tag <tag>]
                                [--version <version>] [--platforms <os/arch,...>]
                                [--also-tag <tag>]
       scripts/image build      --repository <registry/path/name> [--tag <tag>]
                                [--version <version>] [--platforms <os/arch,...>]
                                [--also-tag <tag>]

  build-push     build, push and print <repository>@sha256:<digest>
  build          build only and print <repository>:<tag>
  --repository   image repository to push to (required)
  --tag          tag (default: the short git revision of this checkout)
  --version      version stamped into the binary (default: the VERSION file)
  --platforms    target platform(s), e.g. linux/amd64,linux/arm64 (default: host arch)
  --also-tag     additional tag to apply/push (repeatable, e.g. --also-tag latest)
USAGE
}

die() { printf 'scripts/image: %s\n' "$*" >&2; exit 1; }

action="${1:-}"
[[ "$action" == "build-push" || "$action" == "build" ]] || { usage >&2; exit 2; }
shift

repository=""
tag=""
version=""
platforms=""
also_tags=()
while [[ $# -gt 0 ]]; do
  case "$1" in
    --repository) [[ $# -ge 2 ]] || die "--repository requires a value"; repository="$2"; shift 2 ;;
    --tag) [[ $# -ge 2 ]] || die "--tag requires a value"; tag="$2"; shift 2 ;;
    --version) [[ $# -ge 2 ]] || die "--version requires a value"; version="$2"; shift 2 ;;
    --platforms) [[ $# -ge 2 ]] || die "--platforms requires a value"; platforms="$2"; shift 2 ;;
    --also-tag) [[ $# -ge 2 ]] || die "--also-tag requires a value"; also_tags+=("$2"); shift 2 ;;
    -h|--help) usage; exit 0 ;;
    *) die "unknown option: $1" ;;
  esac
done
[[ -n "$repository" ]] || die "--repository is required"
command -v podman >/dev/null 2>&1 || die "podman is required"
revision="$(git -C "$repo_root" rev-parse HEAD)"
[[ -n "$tag" ]] || tag="${revision:0:12}"
[[ "$tag" =~ ^[0-9A-Za-z_][0-9A-Za-z._-]*$ ]] || die "tag '${tag}' is not a valid image tag"
for extra_tag in "${also_tags[@]}"; do
  [[ "$extra_tag" =~ ^[0-9A-Za-z_][0-9A-Za-z._-]*$ ]] || die "also-tag '${extra_tag}' is not a valid image tag"
done
[[ -n "$version" ]] || version="$(<"${repo_root}/VERSION")"
[[ "$version" =~ ^[0-9A-Za-z][0-9A-Za-z.+-]*$ ]] || die "version '${version}' is not a version string"

multiarch=0
if [[ -n "$platforms" ]]; then
  IFS=',' read -r -a platform_list <<<"$platforms"
  [[ ${#platform_list[@]} -ge 1 ]] || die "--platforms is empty"
  for p in "${platform_list[@]}"; do
    [[ "$p" =~ ^[a-z0-9]+/[a-z0-9._-]+(/[a-z0-9._-]+)?$ ]] || die "platform '${p}' is invalid (expected os/arch)"
  done
  if [[ ${#platform_list[@]} -gt 1 ]]; then
    multiarch=1
  fi
fi

ref="${repository}:${tag}"
digestfile="$(mktemp)"
trap 'rm -f "$digestfile"' EXIT

common_build_args=(
  --format oci -q
  -f "${repo_root}/deploy/images/kodama/Containerfile"
  --build-arg "VERSION=${version}"
  --build-arg "REVISION=${revision}"
  --label "org.opencontainers.image.version=${version}"
  --label "org.opencontainers.image.revision=${revision}"
)

if [[ "$multiarch" -eq 1 ]]; then
  if podman manifest exists "$ref" >/dev/null 2>&1; then
    podman manifest rm "$ref" >/dev/null
  elif podman image exists "$ref"; then
    # A single-arch image holds the name (the release workflow builds and
    # tests one first); `podman manifest create` refuses a name in use.
    podman untag "$ref" "$ref" >/dev/null
  fi
  podman manifest create "$ref" >/dev/null
  podman build "${common_build_args[@]}" --platform "$platforms" --manifest "$ref" "$repo_root" >/dev/null
  for extra_tag in "${also_tags[@]}"; do
    if [[ "$extra_tag" != "$tag" ]]; then
      podman tag "$ref" "${repository}:${extra_tag}" >/dev/null
    fi
  done
  if [[ "$action" == "build" ]]; then
    printf '%s\n' "$ref"
    exit 0
  fi
  podman manifest push --all --digestfile "$digestfile" "$ref" "docker://${ref}" >/dev/null
  digest="$(cat "$digestfile")"
  [[ "$digest" =~ ^sha256:[0-9a-f]{64}$ ]] || die "push did not report a digest"
  for extra_tag in "${also_tags[@]}"; do
    if [[ "$extra_tag" != "$tag" ]]; then
      podman manifest push --all "$ref" "docker://${repository}:${extra_tag}" >/dev/null
    fi
  done
  printf '%s@%s\n' "$repository" "$digest"
  exit 0
fi

platform_flags=()
if [[ -n "$platforms" ]]; then
  platform_flags+=(--platform "$platforms")
fi

podman build "${common_build_args[@]}" "${platform_flags[@]}" -t "$ref" "$repo_root" >/dev/null
for extra_tag in "${also_tags[@]}"; do
  if [[ "$extra_tag" != "$tag" ]]; then
    podman tag "$ref" "${repository}:${extra_tag}" >/dev/null
  fi
done
if [[ "$action" == "build" ]]; then
  printf '%s\n' "$ref"
  exit 0
fi
podman push --digestfile "$digestfile" "$ref" >/dev/null
digest="$(cat "$digestfile")"
[[ "$digest" =~ ^sha256:[0-9a-f]{64}$ ]] || die "push did not report a digest"
for extra_tag in "${also_tags[@]}"; do
  if [[ "$extra_tag" != "$tag" ]]; then
    podman push "${repository}:${extra_tag}" >/dev/null
  fi
done
printf '%s@%s\n' "$repository" "$digest"
