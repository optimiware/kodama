{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kodama.invalid/contracts/pipeline/v1/schema.json",
  "title": "Kodama pipeline definition (kodama/v1alpha1)",
  "description": "Structural contract of one pipeline document. It states which shapes exist, including the planned M2 agent and gate steps; it does not say which step kinds an installation enables, and it cannot express graph, reference, source-ordering or capability rules. Those are enforced by the shared validator in internal/pipeline.",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": {"const": "kodama/v1alpha1"},
    "kind": {"const": "Pipeline"},
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {"name": {"$ref": "#/$defs/name"}}
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["steps"],
      "properties": {
        "inputs": {
          "type": "object",
          "propertyNames": {"$ref": "#/$defs/identifier"},
          "additionalProperties": {"$ref": "#/$defs/input"}
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/step"}
        }
      }
    }
  },
  "$defs": {
    "name": {
      "description": "Lowercase letter followed by lowercase letters, digits or hyphens; at most 63 characters.",
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,62}$"
    },
    "identifier": {
      "description": "Input and output names. Whole-scalar references address them as inputs.NAME and steps.ID.outputs.NAME.",
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,62}$"
    },
    "text": {
      "type": "string",
      "maxLength": 8192
    },
    "integer": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "scalar": {
      "anyOf": [
        {"$ref": "#/$defs/text"},
        {"type": "boolean"},
        {"$ref": "#/$defs/integer"}
      ]
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": {"enum": ["string", "boolean", "integer", "artifact"]},
        "default": {"$ref": "#/$defs/scalar"},
        "required": {"type": "boolean"}
      }
    },
    "needs": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/name"}
    },
    "when": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input", "equals"],
      "properties": {
        "input": {"$ref": "#/$defs/identifier"},
        "equals": {"$ref": "#/$defs/scalar"}
      }
    },
    "workspace": {
      "description": "none carries no source; read and write name the run commit (run) or an ancestor writer's published commit.",
      "type": "object",
      "additionalProperties": false,
      "required": ["access"],
      "properties": {
        "access": {"enum": ["none", "read", "write"]},
        "from": {"$ref": "#/$defs/name"}
      },
      "allOf": [
        {
          "if": {"properties": {"access": {"const": "none"}}, "required": ["access"]},
          "then": {"not": {"required": ["from"]}}
        },
        {
          "if": {"properties": {"access": {"enum": ["read", "write"]}}, "required": ["access"]},
          "then": {"required": ["from"]}
        }
      ]
    },
    "environment": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
    },
    "image": {
      "description": "Digest-pinned image reference; a tag alone is mutable and rejected.",
      "type": "string",
      "maxLength": 512,
      "pattern": "^[a-z0-9][A-Za-z0-9._/:-]*@sha256:[0-9a-f]{64}$"
    },
    "secretRef": {
      "type": "string",
      "pattern": "^secret://project/[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "envValue": {
      "anyOf": [
        {"$ref": "#/$defs/scalar"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["secretRef"],
          "properties": {"secretRef": {"$ref": "#/$defs/secretRef"}}
        }
      ]
    },
    "env": {
      "type": "object",
      "propertyNames": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,127}$"},
      "additionalProperties": {"$ref": "#/$defs/envValue"}
    },
    "secretFiles": {
      "type": "object",
      "propertyNames": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
      "additionalProperties": {"$ref": "#/$defs/secretRef"}
    },
    "retry": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "maxAttempts": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
        "backoffSeconds": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
        "on": {
          "type": "array",
          "uniqueItems": true,
          "items": {"enum": ["infrastructure", "transient"]}
        }
      }
    },
    "outputs": {
      "type": "object",
      "propertyNames": {"$ref": "#/$defs/identifier"},
      "additionalProperties": {"$ref": "#/$defs/output"}
    },
    "output": {
      "description": "Artifact outputs are files below /kodama/outputs; scalar and OCI outputs come from the result manifest and carry no path.",
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": {"enum": ["string", "boolean", "integer", "artifact", "ociArtifact"]},
        "path": {"type": "string", "maxLength": 1024}
      },
      "allOf": [
        {
          "if": {"properties": {"type": {"const": "artifact"}}, "required": ["type"]},
          "then": {"required": ["path"]},
          "else": {"not": {"required": ["path"]}}
        }
      ]
    },
    "step": {
      "type": "object",
      "required": ["id", "kind"],
      "properties": {
        "id": {"$ref": "#/$defs/name"},
        "kind": {"enum": ["container", "agent", "gate"]}
      },
      "allOf": [
        {"if": {"properties": {"kind": {"const": "container"}}, "required": ["kind"]}, "then": {"$ref": "#/$defs/containerStep"}},
        {"if": {"properties": {"kind": {"const": "agent"}}, "required": ["kind"]}, "then": {"$ref": "#/$defs/agentStep"}},
        {"if": {"properties": {"kind": {"const": "gate"}}, "required": ["kind"]}, "then": {"$ref": "#/$defs/gateStep"}}
      ]
    },
    "containerStep": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "image", "command", "timeoutSeconds"],
      "properties": {
        "id": {"$ref": "#/$defs/name"},
        "kind": {"const": "container"},
        "needs": {"$ref": "#/$defs/needs"},
        "when": {"$ref": "#/$defs/when"},
        "workspace": {"$ref": "#/$defs/workspace"},
        "environment": {"$ref": "#/$defs/environment"},
        "image": {"$ref": "#/$defs/image"},
        "command": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/text"}},
        "args": {"type": "array", "items": {"$ref": "#/$defs/text"}},
        "env": {"$ref": "#/$defs/env"},
        "secretFiles": {"$ref": "#/$defs/secretFiles"},
        "timeoutSeconds": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
        "retry": {"$ref": "#/$defs/retry"},
        "outputs": {"$ref": "#/$defs/outputs"}
      }
    },
    "agentStep": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "agent", "timeoutSeconds"],
      "properties": {
        "id": {"$ref": "#/$defs/name"},
        "kind": {"const": "agent"},
        "needs": {"$ref": "#/$defs/needs"},
        "when": {"$ref": "#/$defs/when"},
        "workspace": {"$ref": "#/$defs/workspace"},
        "agent": {
          "type": "object",
          "additionalProperties": false,
          "required": ["profile"],
          "properties": {
            "profile": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@-]{0,127}$"}
          }
        },
        "timeoutSeconds": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
        "retry": {"$ref": "#/$defs/retry"},
        "outputs": {"$ref": "#/$defs/outputs"}
      }
    },
    "gateStep": {
      "description": "Gates are unconditional and carry no image, retry, workspace, outputs or Pod.",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind"],
      "properties": {
        "id": {"$ref": "#/$defs/name"},
        "kind": {"const": "gate"},
        "needs": {"$ref": "#/$defs/needs"},
        "gate": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "evidence": {"type": "array", "items": {"$ref": "#/$defs/text"}},
            "deploymentId": {"$ref": "#/$defs/text"}
          }
        }
      }
    }
  }
}
