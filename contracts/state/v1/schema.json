{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kodama.invalid/contracts/state/v1/schema.json",
  "title": "Kodama state envelope v1",
  "description": "The provider-neutral state entry and conditional-write request. Values are opaque bounded JSON; artifact references are explicit retention roots.",
  "$ref": "#/$defs/entry",
  "$defs": {
    "artifactReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifactId", "digest"],
      "properties": {
        "artifactId": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"},
        "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["namespace", "key", "value", "generation", "revision", "createdAt", "updatedAt"],
      "properties": {
        "namespace": {"type": "string", "pattern": "^[a-z0-9]([-a-z0-9]{0,126}[a-z0-9])?$"},
        "key": {"type": "string", "minLength": 1, "maxLength": 512},
        "value": {},
        "artifactReferences": {
          "type": "array",
          "maxItems": 32,
          "items": {"$ref": "#/$defs/artifactReference"}
        },
        "generation": {"type": "integer", "minimum": 1},
        "revision": {"type": "integer", "minimum": 1},
        "createdAt": {"type": "string", "format": "date-time"},
        "updatedAt": {"type": "string", "format": "date-time"},
        "updatedBy": {"type": "string", "maxLength": 256}
      }
    },
    "writeRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value"],
      "properties": {
        "value": {},
        "artifactReferences": {
          "type": "array",
          "maxItems": 32,
          "items": {"$ref": "#/$defs/artifactReference"}
        }
      }
    }
  }
}
