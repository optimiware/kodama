{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kodama.invalid/qa/report-v1.schema.json",
  "title": "Kodama QA report v1",
  "description": "The structured report an exploratory QA attempt returns as its declared report artifact. Strict: no additional properties; every field is written and a nullable one is an explicit null. Ownership, deployment identity and evidence are verified against trusted records by the Go use case, never by this schema.",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "subject", "deployment", "summary", "observations"],
  "properties": {
    "format": {"const": "kodama/qa-report/v1"},
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workItemId", "contentRevision"],
      "properties": {
        "workItemId": {"$ref": "#/$defs/ID"},
        "contentRevision": {"type": "integer", "minimum": 1, "maximum": 9007199254740991}
      }
    },
    "deployment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "environmentId", "configDigest", "candidateCommit", "imageDigest"],
      "properties": {
        "id": {"$ref": "#/$defs/ID"},
        "environmentId": {"$ref": "#/$defs/ID"},
        "configDigest": {"$ref": "#/$defs/Digest"},
        "candidateCommit": {"$ref": "#/$defs/GitCommit"},
        "imageDigest": {"$ref": "#/$defs/Digest"}
      }
    },
    "summary": {"type": "string", "minLength": 1, "maxLength": 2000},
    "observations": {
      "type": "array",
      "maxItems": 20,
      "items": {"$ref": "#/$defs/Observation"}
    }
  },
  "$defs": {
    "ID": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"},
    "Digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "GitCommit": {"type": "string", "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$"},
    "Observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "severity", "criterionId", "location", "steps", "expected", "actual", "evidence"],
      "properties": {
        "title": {"type": "string", "minLength": 1, "maxLength": 160},
        "severity": {"enum": ["critical", "major", "minor", "trivial"]},
        "criterionId": {"oneOf": [{"type": "null"}, {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"}]},
        "location": {"type": "string", "pattern": "^/[^\\s?#]*$", "maxLength": 512},
        "steps": {"type": "array", "minItems": 1, "maxItems": 20, "items": {"type": "string", "minLength": 1, "maxLength": 500}},
        "expected": {"type": "string", "minLength": 1, "maxLength": 1000},
        "actual": {"type": "string", "minLength": 1, "maxLength": 1000},
        "evidence": {"type": "array", "minItems": 1, "maxItems": 8, "items": {"$ref": "#/$defs/Evidence"}}
      }
    },
    "Evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifactId", "digest", "kind", "note"],
      "properties": {
        "artifactId": {"$ref": "#/$defs/ID"},
        "digest": {"$ref": "#/$defs/Digest"},
        "kind": {"enum": ["screenshot", "trace", "log"]},
        "note": {"oneOf": [{"type": "null"}, {"type": "string", "minLength": 1, "maxLength": 200}]}
      }
    }
  }
}
